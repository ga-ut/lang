fn identity(value) {
  return value;
}

fn main() {
  memory cell 8;
  let left = 7;
  let right = 5;
  let calculated = sub(mul(add(left, right), 3), 1);
  let failed = 0;

  store64(calculated, cell);
  if eq(load64(cell), 35) {
  } else {
    failed = 1;
  }

  if eq(sub(left, right), 2) {
  } else {
    failed = 2;
  }

  if eq(sub(left, sub(right, 2)), 4) {
  } else {
    failed = 3;
  }

  if eq(identity(add(left, right)), 12) {
  } else {
    failed = 4;
  }

  return failed;
}
