# Gaut OS F0 for the checked AArch64 QEMU virt board.

target qemu_virt;

fn uart_write(byte) {
  let uart = 150994944;
  let transmit_full = 32;

  while bitand(load32(add(uart, 24)), transmit_full) {
  }

  store32(byte, uart);
  return 0;
}

fn main() {
  drop uart_write(103);
  drop uart_write(97);
  drop uart_write(117);
  drop uart_write(116);
  drop uart_write(45);
  drop uart_write(111);
  drop uart_write(115);
  drop uart_write(58);
  drop uart_write(32);
  drop uart_write(98);
  drop uart_write(111);
  drop uart_write(111);
  drop uart_write(116);
  drop uart_write(10);
  return 0;
}
