fn main() {
  memory message 10;
  let answer = math.vector.answer();

  if eq(answer, 42) {
    store8(109, message);
    store8(111, add(message, 1));
    store8(100, add(message, 2));
    store8(117, add(message, 3));
    store8(108, add(message, 4));
    store8(101, add(message, 5));
    store8(32, add(message, 6));
    store8(111, add(message, 7));
    store8(107, add(message, 8));
    store8(10, add(message, 9));
  }

  drop host.write(1, message, 10);
  return answer;
}
