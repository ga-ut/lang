# Gaut 0.4 compiler, written in readable Gaut.
#
# This compiler validates Gaut source and directly emits either a static
# AArch64 Linux ELF or a freestanding raw image.

fn state_get(state, offset) {
  return load64(add(state, offset));
}

fn state_set(state, offset, value) {
  store64(value, add(state, offset));
  return 0;
}

fn fail(state) {
  drop host.write(2, add(state, 65000), 21);
  host.exit(2);
  return 0;
}

fn emit_word(state, value) {
  let cursor = state_get(state, 16);

  if lt(sub(state_get(state, 128), cursor), 4) {
    drop fail(state);
  }

  store32(value, cursor);
  drop state_set(state, 16, add(cursor, 4));
  drop state_set(state, 136, add(state_get(state, 136), 1));
  return sub(state_get(state, 136), 1);
}

fn patch_word(state, index, value) {
  store32(value, add(state_get(state, 152), mul(index, 4)));
  return 0;
}

fn patch_branch(state, index, destination, link) {
  let instruction = 335544320;

  if link {
    instruction = 2483027968;
  }

  instruction = bitor(instruction, bitand(sub(destination, index), 67108863));
  drop patch_word(state, index, instruction);
  return 0;
}

fn patch_zero_branch(state, index, destination) {
  let delta = bitand(sub(destination, index), 524287);
  drop patch_word(state, index, bitor(3019898880, shl(delta, 5)));
  return 0;
}

fn patch_short_branch(state, index, destination, instruction) {
  let delta = bitand(sub(destination, index), 524287);
  drop patch_word(state, index, bitor(instruction, shl(delta, 5)));
  return 0;
}

fn emit_move(state, register, value) {
  let index = 1;
  let chunk = bitand(value, 65535);

  drop emit_word(state, bitor(bitor(3531603968, shl(chunk, 5)), register));

  while lt(index, 4) {
    chunk = bitand(shr(value, mul(index, 16)), 65535);
    if chunk {
      drop emit_word(state, bitor(bitor(bitor(4068474880, shl(index, 21)), shl(chunk, 5)), register));
    }
    index = add(index, 1);
  }

  return 0;
}

fn emit_push(state, register) {
  drop emit_word(state, bitor(bitor(4177526784, shl(20, 5)), register));
  drop emit_word(state, 2432705172);
  return 0;
}

fn emit_pop(state, register) {
  drop emit_word(state, 3506446996);
  drop emit_word(state, bitor(bitor(4181721088, shl(20, 5)), register));
  return 0;
}

fn emit_constant(state, value) {
  drop emit_move(state, 0, value);
  drop emit_push(state, 0);
  return 0;
}

fn emit_local_get(state, slot) {
  drop emit_word(state, bitor(bitor(4181721088, shl(slot, 10)), shl(19, 5)));
  drop emit_push(state, 0);
  return 0;
}

fn emit_local_set(state, slot) {
  drop emit_pop(state, 0);
  drop emit_word(state, bitor(bitor(4177526784, shl(slot, 10)), shl(19, 5)));
  return 0;
}

fn emit_memory_base(state, offset) {
  drop emit_move(state, 0, add(65536, offset));
  drop emit_word(state, 2332033632);
  drop emit_push(state, 0);
  return 0;
}

fn emit_binary(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_compare(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 3942711327);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_load(state, instruction) {
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_store(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  return 0;
}

fn emit_host_call(state, number, outputs) {
  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 8, number);
  drop emit_word(state, 3556769793);
  if outputs {
    drop emit_push(state, 0);
  }
  return 0;
}

fn emit_qemu_halt(state) {
  let wait_at = state_get(state, 136);
  let branch = 0;

  drop emit_word(state, 3573751903);
  branch = emit_word(state, 335544320);
  drop patch_branch(state, branch, wait_at, 0);
  return 0;
}

fn emit_qemu_read(state) {
  let valid_branch = 0;
  let loop_at = 0;
  let empty_branch = 0;
  let repeat_branch = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 9, 1191182336);
  drop emit_word(state, 4181721386);
  drop emit_word(state, 3942777183);
  valid_branch = emit_word(state, 1409286153);
  drop emit_qemu_halt(state);
  drop patch_short_branch(state, valid_branch, state_get(state, 136), 1409286153);
  drop emit_word(state, 2432704809);
  drop emit_word(state, 2852783084);

  loop_at = state_get(state, 136);
  empty_branch = emit_word(state, 3019898890);
  drop emit_word(state, 960495915);
  drop emit_word(state, 956301355);
  drop emit_word(state, 2432697641);
  drop emit_word(state, 2432697377);
  drop emit_word(state, 3506439498);
  repeat_branch = emit_word(state, 335544320);
  drop patch_branch(state, repeat_branch, loop_at, 0);
  drop patch_short_branch(state, empty_branch, state_get(state, 136), 3019898890);
  drop emit_word(state, 2852914144);
  drop emit_push(state, 0);
  return 0;
}

fn emit_qemu_write(state) {
  let loop_at = 0;
  let empty_branch = 0;
  let poll_at = 0;
  let busy_branch = 0;
  let repeat_branch = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 2852258797);
  drop emit_move(state, 9, 150994944);
  drop emit_move(state, 12, 32);
  drop emit_word(state, 2432721194);

  loop_at = state_get(state, 136);
  empty_branch = emit_word(state, 3019898882);
  poll_at = state_get(state, 136);
  drop emit_word(state, 3107979595);
  drop emit_word(state, 2316042603);
  busy_branch = emit_word(state, 3036676107);
  drop patch_short_branch(state, busy_branch, poll_at, 3036676107);
  drop emit_word(state, 960495659);
  drop emit_word(state, 3103785259);
  drop emit_word(state, 2432697377);
  drop emit_word(state, 3506439234);
  repeat_branch = emit_word(state, 335544320);
  drop patch_branch(state, repeat_branch, loop_at, 0);
  drop patch_short_branch(state, empty_branch, state_get(state, 136), 3019898882);
  drop emit_word(state, 2852979680);
  drop emit_push(state, 0);
  return 0;
}

fn write_header(state) {
  let output = state_get(state, 24);

  store32(1179403647, output);
  store32(65794, add(output, 4));
  store32(0, add(output, 8));
  store32(0, add(output, 12));
  store32(11993090, add(output, 16));
  store32(1, add(output, 20));
  store32(4194424, add(output, 24));
  store32(0, add(output, 28));
  store32(64, add(output, 32));
  store32(0, add(output, 36));
  store32(0, add(output, 40));
  store32(0, add(output, 44));
  store32(0, add(output, 48));
  store32(3670080, add(output, 52));
  store32(1, add(output, 56));
  store32(0, add(output, 60));
  store32(1, add(output, 64));
  store32(5, add(output, 68));
  store32(0, add(output, 72));
  store32(0, add(output, 76));
  store32(4194304, add(output, 80));
  store32(0, add(output, 84));
  store32(4194304, add(output, 88));
  store32(0, add(output, 92));
  store32(0, add(output, 96));
  store32(0, add(output, 100));
  store32(0, add(output, 104));
  store32(0, add(output, 108));
  store32(4096, add(output, 112));
  store32(0, add(output, 116));
  return 0;
}

fn emit_entry(state, platform) {
  let entry_call = 0;
  let wait_at = 0;
  let branch = 0;

  if platform {
    drop state_set(state, 152, state_get(state, 24));
    drop state_set(state, 16, state_get(state, 24));
    drop emit_move(state, 0, 1207959552);
    drop emit_word(state, 2432696351);
    drop emit_word(state, 3510895615);
    drop emit_word(state, 2432697331);
    drop emit_word(state, 2436892660);
    drop emit_word(state, 2434794485);
    entry_call = emit_word(state, 2483027968);
    drop emit_pop(state, 0);
    wait_at = state_get(state, 136);
    drop emit_word(state, 3573751903);
    branch = emit_word(state, 335544320);
    drop patch_branch(state, branch, wait_at, 0);
  } else {
    drop write_header(state);
    drop state_set(state, 152, add(state_get(state, 24), 120));
    drop state_set(state, 16, state_get(state, 152));
    drop emit_word(state, 3510895615);
    drop emit_word(state, 2432697331);
    drop emit_word(state, 2436892660);
    drop emit_word(state, 2434794485);
    entry_call = emit_word(state, 2483027968);
    drop emit_pop(state, 0);
    drop emit_move(state, 8, 93);
    drop emit_word(state, 3556769793);
  }

  return entry_call;
}

fn is_name_start(byte) {
  let result = 0;

  if bitand(lt(64, byte), lt(byte, 91)) {
    result = 1;
  }
  if bitand(lt(96, byte), lt(byte, 123)) {
    result = 1;
  }
  if eq(byte, 95) {
    result = 1;
  }

  return result;
}

fn is_name_continue(byte) {
  let result = is_name_start(byte);

  if bitand(lt(47, byte), lt(byte, 58)) {
    result = 1;
  }
  if eq(byte, 46) {
    result = 1;
  }

  return result;
}

fn next_token(state) {
  let skipping = 1;
  let cursor = 0;
  let end = 0;
  let byte = 0;
  let scanning = 0;
  let digit = 0;
  let value = 0;

  while skipping {
    cursor = state_get(state, 0);
    end = state_get(state, 8);

    if eq(lt(cursor, end), 0) {
      drop state_set(state, 32, 0);
      skipping = 0;
    } else {
      byte = load8(cursor);

      if bitor(bitor(eq(byte, 32), eq(byte, 9)), bitor(eq(byte, 10), eq(byte, 13))) {
        drop state_set(state, 0, add(cursor, 1));
      } else {
        if eq(byte, 35) {
          scanning = 1;
          while bitand(scanning, lt(state_get(state, 0), end)) {
            cursor = state_get(state, 0);
            if eq(load8(cursor), 10) {
              drop state_set(state, 0, add(cursor, 1));
              scanning = 0;
            } else {
              drop state_set(state, 0, add(cursor, 1));
            }
          }
        } else {
          skipping = 0;
        }
      }
    }
  }

  cursor = state_get(state, 0);
  end = state_get(state, 8);

  if lt(cursor, end) {
    byte = load8(cursor);
    drop state_set(state, 40, cursor);

    if is_name_start(byte) {
      cursor = add(cursor, 1);
      scanning = 1;

      while bitand(scanning, lt(cursor, end)) {
        if is_name_continue(load8(cursor)) {
          cursor = add(cursor, 1);
        } else {
          scanning = 0;
        }
      }

      drop state_set(state, 0, cursor);
      drop state_set(state, 48, sub(cursor, state_get(state, 40)));
      drop state_set(state, 32, 1);
    } else {
      if bitand(lt(47, byte), lt(byte, 58)) {
        value = 0;
        scanning = 1;

        while bitand(scanning, lt(cursor, end)) {
          byte = load8(cursor);
          if bitand(lt(47, byte), lt(byte, 58)) {
            digit = sub(byte, 48);
            if bitor(lt(1844674407370955161, value), bitand(eq(value, 1844674407370955161), lt(5, digit))) {
              drop fail(state);
            }
            value = add(mul(value, 10), digit);
            cursor = add(cursor, 1);
          } else {
            scanning = 0;
          }
        }

        drop state_set(state, 0, cursor);
        drop state_set(state, 48, sub(cursor, state_get(state, 40)));
        drop state_set(state, 56, value);
        drop state_set(state, 32, 2);
      } else {
        drop state_set(state, 0, add(cursor, 1));
        drop state_set(state, 48, 0);

        if eq(byte, 40) {
          drop state_set(state, 32, 3);
        } else {
          if eq(byte, 41) {
            drop state_set(state, 32, 4);
          } else {
            if eq(byte, 123) {
              drop state_set(state, 32, 5);
            } else {
              if eq(byte, 125) {
                drop state_set(state, 32, 6);
              } else {
                if eq(byte, 44) {
                  drop state_set(state, 32, 7);
                } else {
                  if eq(byte, 61) {
                    drop state_set(state, 32, 8);
                  } else {
                    if eq(byte, 59) {
                      drop state_set(state, 32, 9);
                    } else {
                      drop fail(state);
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return 0;
}

fn span_equal(left, left_length, right, right_length) {
  let index = 0;
  let equal = eq(left_length, right_length);

  while bitand(equal, lt(index, left_length)) {
    if eq(eq(load8(add(left, index)), load8(add(right, index))), 0) {
      equal = 0;
    }
    index = add(index, 1);
  }

  return equal;
}

fn canonical_add(state, first, second, length, info) {
  let entry = add(add(state, 4096), mul(state_get(state, 96), 32));

  store64(first, entry);
  store64(second, add(entry, 8));
  store64(length, add(entry, 16));
  store64(info, add(entry, 24));
  drop state_set(state, 96, add(state_get(state, 96), 1));
  return 0;
}

fn canonical_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, state_get(state, 96)), eq(result, 0)) {
    entry = add(add(state, 4096), mul(index, 32));
    if span_equal(address, length, entry, load64(add(entry, 16))) {
      result = load64(add(entry, 24));
    }
    index = add(index, 1);
  }

  return result;
}

fn function_add(state, address, length, arity, code_index) {
  let entry = 0;

  if eq(lt(state_get(state, 64), 256), 0) {
    drop fail(state);
  }

  entry = add(add(state, 8192), mul(state_get(state, 64), 32));
  store64(address, entry);
  store64(length, add(entry, 8));
  store64(arity, add(entry, 16));
  store64(code_index, add(entry, 24));
  drop state_set(state, 64, add(state_get(state, 64), 1));
  return 0;
}

fn function_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, state_get(state, 64)), eq(result, 0)) {
    entry = add(add(state, 8192), mul(index, 32));
    if span_equal(address, length, load64(entry), load64(add(entry, 8))) {
      result = entry;
    }
    index = add(index, 1);
  }

  return result;
}

fn local_add(state, address, length, kind, value) {
  let entry = 0;

  if eq(lt(state_get(state, 72), 256), 0) {
    drop fail(state);
  }

  entry = add(add(state, 16384), mul(state_get(state, 72), 32));
  store64(address, entry);
  store64(length, add(entry, 8));
  store64(kind, add(entry, 16));
  store64(value, add(entry, 24));
  drop state_set(state, 72, add(state_get(state, 72), 1));
  return 0;
}

fn local_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, state_get(state, 72)), eq(result, 0)) {
    entry = add(add(state, 16384), mul(index, 32));
    if span_equal(address, length, load64(entry), load64(add(entry, 8))) {
      result = entry;
    }
    index = add(index, 1);
  }

  return result;
}

fn init_canonical(state) {
  drop state_set(state, 96, 0);

  drop canonical_add(state, 28262, 0, 2, 16777217);
  drop canonical_add(state, 7628140, 0, 3, 16777218);
  drop canonical_add(state, 133532402673005, 0, 6, 16777219);
  drop canonical_add(state, 1886351972, 0, 4, 16777220);
  drop canonical_add(state, 26217, 0, 2, 16777221);
  drop canonical_add(state, 1702063205, 0, 4, 16777222);
  drop canonical_add(state, 435610544247, 0, 5, 16777223);
  drop canonical_add(state, 121437875889522, 0, 6, 16777224);
  drop canonical_add(state, 127978876068212, 0, 6, 16777225);
  drop canonical_add(state, 8244250745242477937, 116, 9, 50331649);

  drop canonical_add(state, 6579297, 0, 3, 33620496);
  drop canonical_add(state, 6452595, 0, 3, 33620497);
  drop canonical_add(state, 7107949, 0, 3, 33620498);
  drop canonical_add(state, 110425244199266, 0, 6, 33620499);
  drop canonical_add(state, 491496171874, 0, 5, 33620500);
  drop canonical_add(state, 125823087831394, 0, 6, 33620501);
  drop canonical_add(state, 7104627, 0, 3, 33620502);
  drop canonical_add(state, 7497843, 0, 3, 33620503);
  drop canonical_add(state, 29029, 0, 2, 33620504);
  drop canonical_add(state, 29804, 0, 2, 33620505);
  drop canonical_add(state, 242202275692, 0, 5, 33620256);
  drop canonical_add(state, 55196308828012, 0, 6, 33620257);
  drop canonical_add(state, 57408216985452, 0, 6, 33620258);
  drop canonical_add(state, 62008362759283, 0, 6, 33554979);
  drop canonical_add(state, 14130259640153203, 0, 7, 33554980);
  drop canonical_add(state, 14696508128457843, 0, 7, 33554981);
  drop canonical_add(state, 7018141138174570344, 100, 9, 33620800);
  drop canonical_add(state, 7598266562733371240, 25972, 10, 33620801);
  drop canonical_add(state, 7599935621384335208, 116, 9, 33554754);
  drop canonical_add(state, 7886488383309048944, 1853190702, 12, 33554755);
  return 0;
}

fn emit_callable(state, info, address, length) {
  let id = bitand(info, 255);
  let entry = 0;
  let branch = 0;

  if eq(info, 0) {
    entry = function_find(state, address, length);
    if eq(entry, 0) {
      drop fail(state);
    }
    branch = emit_word(state, 2483027968);
    drop patch_branch(state, branch, load64(add(entry, 24)), 1);
  } else {
    if eq(id, 16) {
      drop emit_binary(state, 2332098560);
    } else {
      if eq(id, 17) {
        drop emit_binary(state, 3405840384);
      } else {
        if eq(id, 18) {
          drop emit_binary(state, 2600565760);
        } else {
          if eq(id, 19) {
            drop emit_binary(state, 2315321344);
          } else {
            if eq(id, 20) {
              drop emit_binary(state, 2852192256);
            } else {
              if eq(id, 21) {
                drop emit_binary(state, 3389063168);
              } else {
                if eq(id, 22) {
                  drop emit_binary(state, 2596347904);
                } else {
                  if eq(id, 23) {
                    drop emit_binary(state, 2596348928);
                  } else {
                    if eq(id, 24) {
                      drop emit_compare(state, 2594117600);
                    } else {
                      if eq(id, 25) {
                        drop emit_compare(state, 2594121696);
                      } else {
                        if eq(id, 32) {
                          drop emit_load(state, 960495616);
                        } else {
                          if eq(id, 33) {
                            drop emit_load(state, 3107979264);
                          } else {
                            if eq(id, 34) {
                              drop emit_load(state, 4181721088);
                            } else {
                              if eq(id, 35) {
                                drop emit_store(state, 956301344);
                              } else {
                                if eq(id, 36) {
                                  drop emit_store(state, 3103784992);
                                } else {
                                  if eq(id, 37) {
                                    drop emit_store(state, 4177526816);
                                  } else {
                                    if eq(id, 64) {
                                      if state_get(state, 160) {
                                        drop emit_qemu_read(state);
                                      } else {
                                        drop emit_host_call(state, 63, 1);
                                      }
                                    } else {
                                      if eq(id, 65) {
                                        if state_get(state, 160) {
                                          drop emit_qemu_write(state);
                                        } else {
                                          drop emit_host_call(state, 64, 1);
                                        }
                                      } else {
                                        if eq(id, 66) {
                                          if state_get(state, 160) {
                                            drop emit_pop(state, 0);
                                            drop emit_qemu_halt(state);
                                          } else {
                                            drop emit_pop(state, 0);
                                            drop emit_move(state, 8, 93);
                                            drop emit_word(state, 3556769793);
                                          }
                                        } else {
                                          if eq(id, 67) {
                                            drop emit_pop(state, 0);
                                            if state_get(state, 160) {
                                              drop emit_word(state, 3592355840);
                                            }
                                          } else {
                                            drop fail(state);
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return 0;
}

fn expression_push(state, address, length, info, arity, outputs, user_entry) {
  let depth = state_get(state, 120);
  let frame = add(add(state, 32768), mul(depth, 64));

  if eq(lt(depth, 64), 0) {
    drop fail(state);
  }

  store64(address, frame);
  store64(length, add(frame, 8));
  store64(info, add(frame, 16));
  store64(0, add(frame, 24));
  store64(arity, add(frame, 32));
  store64(outputs, add(frame, 40));
  store64(user_entry, add(frame, 48));
  drop state_set(state, 120, add(depth, 1));
  return frame;
}

fn expression_top(state) {
  let depth = state_get(state, 120);
  let frame = 0;

  if eq(depth, 0) {
    drop fail(state);
  }

  frame = add(add(state, 32768), mul(sub(depth, 1), 64));
  return frame;
}

fn expression_pop(state) {
  let frame = expression_top(state);
  drop state_set(state, 120, sub(state_get(state, 120), 1));
  return frame;
}

fn block_push(state, kind, first, second) {
  let depth = state_get(state, 112);
  let entry = 0;

  if eq(lt(depth, 64), 0) {
    drop fail(state);
  }

  entry = add(add(state, 24576), mul(depth, 24));
  store64(kind, entry);
  store64(first, add(entry, 8));
  store64(second, add(entry, 16));
  drop state_set(state, 112, add(depth, 1));
  return entry;
}

fn block_top(state) {
  let depth = state_get(state, 112);
  let entry = 0;

  if eq(depth, 0) {
    drop fail(state);
  }

  entry = add(add(state, 24576), mul(sub(depth, 1), 24));
  return entry;
}

fn block_set(state, kind, first, second) {
  let entry = block_top(state);
  store64(kind, entry);
  store64(first, add(entry, 8));
  store64(second, add(entry, 16));
  return 0;
}

fn block_pop(state) {
  let entry = block_top(state);
  drop state_set(state, 112, sub(state_get(state, 112), 1));
  return entry;
}

fn name_available(state, address, length, function_address, function_length) {
  let available = 1;

  if canonical_find(state, address, length) {
    available = 0;
  }
  if function_find(state, address, length) {
    available = 0;
  }
  if local_find(state, address, length) {
    available = 0;
  }
  if span_equal(address, length, function_address, function_length) {
    available = 0;
  }

  return available;
}

fn parse_expression(state) {
  let base_depth = state_get(state, 120);
  let need_value = 1;
  let done = 0;
  let result_outputs = 1;
  let kind = 0;
  let address = 0;
  let length = 0;
  let info = 0;
  let arity = 0;
  let outputs = 0;
  let user_entry = 0;
  let entry = 0;
  let frame = 0;
  let arguments = 0;

  while eq(done, 0) {
    if need_value {
      kind = state_get(state, 32);

      if eq(kind, 2) {
        drop emit_constant(state, state_get(state, 56));
        drop next_token(state);
        result_outputs = 1;
        need_value = 0;
      } else {
        if eq(kind, 1) {
          address = state_get(state, 40);
          length = state_get(state, 48);
          drop next_token(state);

          if eq(state_get(state, 32), 3) {
            info = canonical_find(state, address, length);
            user_entry = 0;

            if info {
              if eq(bitand(shr(info, 24), 255), 2) {
                arity = bitand(shr(info, 8), 255);
                outputs = bitand(shr(info, 16), 255);
              } else {
                drop fail(state);
              }
            } else {
              user_entry = function_find(state, address, length);
              if eq(user_entry, 0) {
                drop fail(state);
              }
              arity = load64(add(user_entry, 16));
              outputs = 1;
            }

            frame = expression_push(state, address, length, info, arity, outputs, user_entry);
            drop next_token(state);

            if eq(state_get(state, 32), 4) {
              if arity {
                drop fail(state);
              }
              drop emit_callable(state, info, address, length);
              result_outputs = outputs;
              drop expression_pop(state);
              drop next_token(state);
              need_value = 0;
            } else {
              need_value = 1;
            }
          } else {
            entry = local_find(state, address, length);
            if eq(entry, 0) {
              drop fail(state);
            }

            if eq(load64(add(entry, 16)), 1) {
              drop emit_local_get(state, load64(add(entry, 24)));
            } else {
              if eq(load64(add(entry, 16)), 2) {
                drop emit_memory_base(state, load64(add(entry, 24)));
              } else {
                drop fail(state);
              }
            }

            result_outputs = 1;
            need_value = 0;
          }
        } else {
          drop fail(state);
        }
      }
    } else {
      if eq(state_get(state, 120), base_depth) {
        done = 1;
      } else {
        if eq(result_outputs, 1) {
          frame = expression_top(state);
          arguments = add(load64(add(frame, 24)), 1);
          store64(arguments, add(frame, 24));

          if eq(state_get(state, 32), 7) {
            drop next_token(state);
            need_value = 1;
          } else {
            if eq(state_get(state, 32), 4) {
              if eq(eq(arguments, load64(add(frame, 32))), 0) {
                drop fail(state);
              }

              info = load64(add(frame, 16));
              address = load64(frame);
              length = load64(add(frame, 8));
              result_outputs = load64(add(frame, 40));
              drop emit_callable(state, info, address, length);
              drop expression_pop(state);
              drop next_token(state);
              need_value = 0;
            } else {
              drop fail(state);
            }
          }
        } else {
          drop fail(state);
        }
      }
    }
  }

  return result_outputs;
}

fn parse_function(state) {
  let function_address = 0;
  let function_length = 0;
  let parameter_count = 0;
  let slot = 0;
  let parsing = 1;
  let info = 0;
  let id = 0;
  let expression_outputs = 0;
  let name_address = 0;
  let name_length = 0;
  let entry = 0;
  let block_kind = 0;
  let size = 0;
  let offset = 0;
  let is_main = 0;
  let code_start = 0;
  let block_entry = 0;
  let branch = 0;

  drop next_token(state);

  if eq(eq(state_get(state, 32), 1), 0) {
    drop fail(state);
  }

  function_address = state_get(state, 40);
  function_length = state_get(state, 48);

  if canonical_find(state, function_address, function_length) {
    drop fail(state);
  }
  if function_find(state, function_address, function_length) {
    drop fail(state);
  }

  if eq(function_length, 4) {
    if eq(load8(function_address), 109) {
      if eq(load8(add(function_address, 1)), 97) {
        if eq(load8(add(function_address, 2)), 105) {
          if eq(load8(add(function_address, 3)), 110) {
            is_main = 1;
          }
        }
      }
    }
  }

  drop next_token(state);
  if eq(eq(state_get(state, 32), 3), 0) {
    drop fail(state);
  }
  drop next_token(state);

  drop state_set(state, 72, 0);

  if eq(eq(state_get(state, 32), 4), 0) {
    parsing = 1;
    while parsing {
      if eq(eq(state_get(state, 32), 1), 0) {
        drop fail(state);
      }

      name_address = state_get(state, 40);
      name_length = state_get(state, 48);
      if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
        drop fail(state);
      }
      if eq(lt(state_get(state, 80), 256), 0) {
        drop fail(state);
      }

      slot = state_get(state, 80);
      store64(slot, add(add(state, 36864), mul(parameter_count, 8)));
      drop local_add(state, name_address, name_length, 1, slot);
      drop state_set(state, 80, add(slot, 1));
      parameter_count = add(parameter_count, 1);

      drop next_token(state);
      if eq(state_get(state, 32), 7) {
        drop next_token(state);
      } else {
        parsing = 0;
      }
    }
  }

  if eq(eq(state_get(state, 32), 4), 0) {
    drop fail(state);
  }
  if bitand(is_main, eq(eq(parameter_count, 0), 0)) {
    drop fail(state);
  }

  code_start = state_get(state, 136);
  if is_main {
    drop state_set(state, 144, code_start);
  }
  drop emit_word(state, 4177527486);
  drop emit_word(state, 2432705205);

  slot = parameter_count;
  while lt(0, slot) {
    slot = sub(slot, 1);
    drop emit_local_set(state, load64(add(add(state, 36864), mul(slot, 8))));
  }

  drop next_token(state);
  if eq(eq(state_get(state, 32), 5), 0) {
    drop fail(state);
  }
  drop next_token(state);
  drop state_set(state, 112, 0);
  parsing = 1;

  while parsing {
    if eq(state_get(state, 32), 0) {
      drop fail(state);
    }

    if eq(state_get(state, 32), 6) {
      if eq(state_get(state, 112), 0) {
        drop fail(state);
      }

      block_entry = block_top(state);
      block_kind = load64(block_entry);
      if eq(block_kind, 1) {
        drop next_token(state);
        info = 0;
        if eq(state_get(state, 32), 1) {
          info = canonical_find(state, state_get(state, 40), state_get(state, 48));
        }

        if eq(bitand(info, 255), 6) {
          branch = emit_word(state, 335544320);
          drop patch_zero_branch(state, load64(add(block_entry, 8)), state_get(state, 136));
          drop next_token(state);
          if eq(eq(state_get(state, 32), 5), 0) {
            drop fail(state);
          }
          drop block_set(state, 2, branch, 0);
          drop next_token(state);
        } else {
          drop patch_zero_branch(state, load64(add(block_entry, 8)), state_get(state, 136));
          drop block_pop(state);
        }
      } else {
        if eq(block_kind, 2) {
          drop patch_branch(state, load64(add(block_entry, 8)), state_get(state, 136), 0);
          drop block_pop(state);
          drop next_token(state);
        } else {
          if eq(block_kind, 3) {
            branch = emit_word(state, 335544320);
            drop patch_branch(state, branch, load64(add(block_entry, 8)), 0);
            drop patch_zero_branch(state, load64(add(block_entry, 16)), state_get(state, 136));
            drop block_pop(state);
            drop next_token(state);
          } else {
            drop fail(state);
          }
        }
      }
    } else {
      if eq(eq(state_get(state, 32), 1), 0) {
        drop fail(state);
      }

      info = canonical_find(state, state_get(state, 40), state_get(state, 48));
      id = bitand(info, 255);

      if eq(id, 8) {
        if state_get(state, 112) {
          drop fail(state);
        }

        drop next_token(state);
        expression_outputs = parse_expression(state);
        if eq(eq(expression_outputs, 1), 0) {
          drop fail(state);
        }
        if eq(eq(state_get(state, 32), 9), 0) {
          drop fail(state);
        }
        drop next_token(state);
        if eq(eq(state_get(state, 32), 6), 0) {
          drop fail(state);
        }

        drop emit_word(state, 3506447029);
        drop emit_word(state, 4181721790);
        drop emit_word(state, 3596551104);
        drop next_token(state);
        drop function_add(state, function_address, function_length, parameter_count, code_start);
        if is_main {
          drop state_set(state, 104, 1);
        }
        parsing = 0;
      } else {
        if eq(id, 2) {
          drop next_token(state);
          if eq(eq(state_get(state, 32), 1), 0) {
            drop fail(state);
          }

          name_address = state_get(state, 40);
          name_length = state_get(state, 48);
          if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
            drop fail(state);
          }

          drop next_token(state);
          if eq(eq(state_get(state, 32), 8), 0) {
            drop fail(state);
          }
          drop next_token(state);
          expression_outputs = parse_expression(state);
          if eq(eq(expression_outputs, 1), 0) {
            drop fail(state);
          }
          if eq(lt(state_get(state, 80), 256), 0) {
            drop fail(state);
          }

          slot = state_get(state, 80);
          drop local_add(state, name_address, name_length, 1, slot);
          drop emit_local_set(state, slot);
          drop state_set(state, 80, add(slot, 1));

          if eq(eq(state_get(state, 32), 9), 0) {
            drop fail(state);
          }
          drop next_token(state);
        } else {
          if eq(id, 3) {
            drop next_token(state);
            if eq(eq(state_get(state, 32), 1), 0) {
              drop fail(state);
            }

            name_address = state_get(state, 40);
            name_length = state_get(state, 48);
            if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
              drop fail(state);
            }

            drop next_token(state);
            if eq(eq(state_get(state, 32), 2), 0) {
              drop fail(state);
            }
            size = state_get(state, 56);
            if eq(size, 0) {
              drop fail(state);
            }

            offset = bitand(add(state_get(state, 88), 7), 18446744073709551608);
            if lt(sub(917504, offset), size) {
              drop fail(state);
            }

            drop local_add(state, name_address, name_length, 2, offset);
            drop state_set(state, 88, add(offset, size));
            drop next_token(state);
            if eq(eq(state_get(state, 32), 9), 0) {
              drop fail(state);
            }
            drop next_token(state);
          } else {
            if eq(id, 4) {
              drop next_token(state);
              expression_outputs = parse_expression(state);
              if eq(eq(expression_outputs, 1), 0) {
                drop fail(state);
              }
              drop emit_pop(state, 0);
              if eq(eq(state_get(state, 32), 9), 0) {
                drop fail(state);
              }
              drop next_token(state);
            } else {
              if eq(id, 5) {
                drop next_token(state);
                expression_outputs = parse_expression(state);
                if eq(eq(expression_outputs, 1), 0) {
                  drop fail(state);
                }
                drop emit_pop(state, 0);
                branch = emit_word(state, 3019898880);
                if eq(eq(state_get(state, 32), 5), 0) {
                  drop fail(state);
                }
                drop block_push(state, 1, branch, 0);
                drop next_token(state);
              } else {
                if eq(id, 7) {
                  branch = state_get(state, 136);
                  drop next_token(state);
                  expression_outputs = parse_expression(state);
                  if eq(eq(expression_outputs, 1), 0) {
                    drop fail(state);
                  }
                  drop emit_pop(state, 0);
                  entry = emit_word(state, 3019898880);
                  if eq(eq(state_get(state, 32), 5), 0) {
                    drop fail(state);
                  }
                  drop block_push(state, 3, branch, entry);
                  drop next_token(state);
                } else {
                  if eq(bitand(shr(info, 24), 255), 1) {
                    drop fail(state);
                  }

                  name_address = state_get(state, 40);
                  name_length = state_get(state, 48);
                  drop next_token(state);

                  if eq(state_get(state, 32), 8) {
                    entry = local_find(state, name_address, name_length);
                    if eq(entry, 0) {
                      drop fail(state);
                    }
                    if eq(eq(load64(add(entry, 16)), 1), 0) {
                      drop fail(state);
                    }

                    drop next_token(state);
                    expression_outputs = parse_expression(state);
                    if eq(eq(expression_outputs, 1), 0) {
                      drop fail(state);
                    }
                    drop emit_local_set(state, load64(add(entry, 24)));
                    if eq(eq(state_get(state, 32), 9), 0) {
                      drop fail(state);
                    }
                    drop next_token(state);
                  } else {
                    if eq(eq(state_get(state, 32), 3), 0) {
                      drop fail(state);
                    }

                    drop state_set(state, 0, name_address);
                    drop next_token(state);
                    expression_outputs = parse_expression(state);
                    if expression_outputs {
                      drop fail(state);
                    }
                    if eq(eq(state_get(state, 32), 9), 0) {
                      drop fail(state);
                    }
                    drop next_token(state);
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return 0;
}

fn main() {
  memory source 131072;
  memory output 262144;
  memory state 65536;
  let input_size = 0;
  let info = 0;
  let entry_call = 0;
  let file_size = 0;
  let cursor = 0;

  store64(7955925652160733543, add(state, 65000));
  store64(8030798176169255286, add(state, 65008));
  store64(44650689141, add(state, 65016));

  input_size = host.read(0, source, 131072);
  if eq(input_size, 131072) {
    if host.read(0, add(state, 64992), 1) {
      drop fail(state);
    }
  }

  drop state_set(state, 0, source);
  drop state_set(state, 8, add(source, input_size));
  drop state_set(state, 24, output);
  drop state_set(state, 64, 0);
  drop state_set(state, 72, 0);
  drop state_set(state, 80, 0);
  drop state_set(state, 88, 0);
  drop state_set(state, 96, 0);
  drop state_set(state, 104, 0);
  drop state_set(state, 112, 0);
  drop state_set(state, 120, 0);
  drop state_set(state, 128, add(output, 262144));
  drop state_set(state, 136, 0);
  drop state_set(state, 144, 0);
  drop state_set(state, 152, 0);
  drop state_set(state, 160, 0);

  drop init_canonical(state);
  drop next_token(state);

  if eq(bitand(canonical_find(state, state_get(state, 40), state_get(state, 48)), 255), 9) {
    drop next_token(state);
    if eq(eq(state_get(state, 32), 1), 0) {
      drop fail(state);
    }
    info = canonical_find(state, state_get(state, 40), state_get(state, 48));
    if eq(eq(info, 50331649), 0) {
      drop fail(state);
    }
    drop state_set(state, 160, 1);
    drop next_token(state);
    if eq(eq(state_get(state, 32), 9), 0) {
      drop fail(state);
    }
    drop next_token(state);
  }

  entry_call = emit_entry(state, state_get(state, 160));

  while eq(eq(state_get(state, 32), 0), 0) {
    if eq(eq(state_get(state, 32), 1), 0) {
      drop fail(state);
    }

    info = canonical_find(state, state_get(state, 40), state_get(state, 48));
    if eq(bitand(info, 255), 1) {
      drop parse_function(state);
    } else {
      drop fail(state);
    }
  }

  if eq(state_get(state, 104), 0) {
    drop fail(state);
  }

  drop patch_branch(state, entry_call, state_get(state, 144), 1);

  file_size = bitand(add(sub(state_get(state, 16), output), 4095), 18446744073709547520);
  if lt(262144, file_size) {
    drop fail(state);
  }

  if eq(state_get(state, 160), 0) {
    store64(file_size, add(output, 96));
    store64(file_size, add(output, 104));
  }
  cursor = state_get(state, 16);
  while lt(cursor, add(output, file_size)) {
    store8(0, cursor);
    cursor = add(cursor, 1);
  }

  platform.run(output);
  drop host.write(1, output, file_size);
  return 0;
}
