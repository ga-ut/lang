fn emit_word(state, value) {
  let cursor = compiler.state_get(state, 16);

  if lt(sub(compiler.state_get(state, 128), cursor), 4) {
    drop compiler.fail(state);
  }

  store32(value, cursor);
  drop compiler.state_set(state, 16, add(cursor, 4));
  drop compiler.state_set(state, 136, add(compiler.state_get(state, 136), 1));
  return sub(compiler.state_get(state, 136), 1);
}

fn patch_word(state, index, value) {
  store32(value, add(compiler.state_get(state, 152), mul(index, 4)));
  return 0;
}

fn patch_branch(state, index, destination, link) {
  let instruction = 335544320;

  if link {
    instruction = 2483027968;
  }

  instruction = bitor(instruction, bitand(sub(destination, index), 67108863));
  drop patch_word(state, index, instruction);
  return 0;
}

fn patch_zero_branch(state, index, destination) {
  let delta = bitand(sub(destination, index), 524287);
  drop patch_word(state, index, bitor(3019898880, shl(delta, 5)));
  return 0;
}

fn patch_short_branch(state, index, destination, instruction) {
  let delta = bitand(sub(destination, index), 524287);
  drop patch_word(state, index, bitor(instruction, shl(delta, 5)));
  return 0;
}

fn emit_move(state, register, value) {
  let index = 1;
  let chunk = bitand(value, 65535);

  drop emit_word(state, bitor(bitor(3531603968, shl(chunk, 5)), register));

  while lt(index, 4) {
    chunk = bitand(shr(value, mul(index, 16)), 65535);
    if chunk {
      drop emit_word(state, bitor(bitor(bitor(4068474880, shl(index, 21)), shl(chunk, 5)), register));
    }
    index = add(index, 1);
  }

  return 0;
}

fn emit_push(state, register) {
  drop emit_word(state, bitor(bitor(4177526784, shl(20, 5)), register));
  drop emit_word(state, 2432705172);
  return 0;
}

fn emit_pop(state, register) {
  drop emit_word(state, 3506446996);
  drop emit_word(state, bitor(bitor(4181721088, shl(20, 5)), register));
  return 0;
}

fn emit_constant(state, value) {
  drop emit_move(state, 0, value);
  drop emit_push(state, 0);
  return 0;
}

fn emit_local_get(state, slot) {
  drop emit_word(state, bitor(bitor(4181721088, shl(slot, 10)), shl(19, 5)));
  drop emit_push(state, 0);
  return 0;
}

fn emit_local_set(state, slot) {
  drop emit_pop(state, 0);
  drop emit_word(state, bitor(bitor(4177526784, shl(slot, 10)), shl(19, 5)));
  return 0;
}

fn emit_memory_base(state, offset) {
  drop emit_move(state, 0, add(65536, offset));
  drop emit_word(state, 2332033632);
  drop emit_push(state, 0);
  return 0;
}

fn emit_binary(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_compare(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 3942711327);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_load(state, instruction) {
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop emit_push(state, 0);
  return 0;
}

fn emit_store(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  return 0;
}

fn emit_host_call(state, number, outputs) {
  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 8, number);
  drop emit_word(state, 3556769793);
  if outputs {
    drop emit_push(state, 0);
  }
  return 0;
}

fn emit_qemu_halt(state) {
  let wait_at = 0;
  let branch = 0;

  drop emit_move(state, 0, 2214592520);
  drop emit_word(state, 3556769794);
  wait_at = compiler.state_get(state, 136);
  drop emit_word(state, 3573751903);
  branch = emit_word(state, 335544320);
  drop patch_branch(state, branch, wait_at, 0);
  return 0;
}

fn emit_branch_register(state, register) {
  drop emit_word(state, bitor(3592355840, shl(register, 5)));
  return 0;
}

fn emit_qemu_exit(state) {
  let shutdown_branch = 0;

  drop emit_pop(state, 0);
  drop emit_word(state, 4043309087);
  shutdown_branch = emit_word(state, 1409286144);
  drop emit_branch_register(state, 22);
  drop patch_short_branch(state, shutdown_branch, compiler.state_get(state, 136), 1409286144);
  drop emit_qemu_halt(state);
  return 0;
}

fn emit_qemu_wait_setup(state) {
  drop emit_move(state, 9, 134217728);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 958432554);
  drop emit_move(state, 10, 128);
  drop emit_word(state, 957383978);
  drop emit_move(state, 10, 2);
  drop emit_word(state, 3103851818);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 3103785258);

  drop emit_move(state, 9, 134283264);
  drop emit_move(state, 10, 255);
  drop emit_word(state, 3103786282);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 3103785258);

  drop emit_move(state, 9, 150994944);
  drop emit_move(state, 10, 2047);
  drop emit_word(state, 3103802666);
  drop emit_move(state, 10, 80);
  drop emit_word(state, 3103799594);
  return 0;
}

fn emit_qemu_uart_read_byte(state) {
  let poll_at = compiler.state_get(state, 136);
  let ready_branch = 0;
  let arrived_branch = 0;
  let repeat_branch = 0;

  drop emit_word(state, 3107985707);
  drop emit_word(state, 168624491);
  ready_branch = emit_word(state, 872415243);
  drop emit_word(state, 3103802670);
  drop emit_word(state, 3107985707);
  drop emit_word(state, 168624491);
  arrived_branch = emit_word(state, 872415243);
  drop emit_word(state, 3573751935);
  repeat_branch = emit_word(state, 335544320);
  drop patch_branch(state, repeat_branch, poll_at, 0);
  drop patch_short_branch(state, ready_branch, compiler.state_get(state, 136), 872415243);
  drop patch_short_branch(state, arrived_branch, compiler.state_get(state, 136), 872415243);
  drop emit_word(state, 3107979563);
  return 0;
}

fn emit_qemu_read(state) {
  let header_loop = 0;
  let header_done = 0;
  let header_repeat = 0;
  let valid_branch = 0;
  let body_loop = 0;
  let body_done = 0;
  let body_repeat = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 9, 150994944);
  drop emit_move(state, 10, 0);
  drop emit_move(state, 12, 16);
  drop emit_move(state, 13, 16);
  drop emit_move(state, 14, 80);

  header_loop = compiler.state_get(state, 136);
  drop emit_word(state, 3943432543);
  header_done = emit_word(state, 1409286144);
  drop emit_qemu_uart_read_byte(state);
  drop emit_word(state, 942303275);
  drop emit_word(state, 2432697674);
  header_repeat = emit_word(state, 335544320);
  drop patch_branch(state, header_repeat, header_loop, 0);
  drop patch_short_branch(state, header_done, compiler.state_get(state, 136), 1409286144);

  drop emit_word(state, 4181722156);
  drop emit_word(state, 2432713100);
  drop emit_word(state, 3942777247);
  valid_branch = emit_word(state, 1409286153);
  drop emit_qemu_halt(state);
  drop patch_short_branch(state, valid_branch, compiler.state_get(state, 136), 1409286153);

  body_loop = compiler.state_get(state, 136);
  drop emit_word(state, 3943432543);
  body_done = emit_word(state, 1409286144);
  drop emit_qemu_uart_read_byte(state);
  drop emit_word(state, 942303275);
  drop emit_word(state, 2432697674);
  body_repeat = emit_word(state, 335544320);
  drop patch_branch(state, body_repeat, body_loop, 0);
  drop patch_short_branch(state, body_done, compiler.state_get(state, 136), 1409286144);

  drop emit_word(state, 2852914144);
  drop emit_push(state, 0);
  return 0;
}

fn emit_qemu_write(state) {
  let loop_at = 0;
  let empty_branch = 0;
  let poll_at = 0;
  let busy_branch = 0;
  let repeat_branch = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 2852258797);
  drop emit_move(state, 9, 150994944);
  drop emit_move(state, 12, 32);
  drop emit_word(state, 2432721194);

  loop_at = compiler.state_get(state, 136);
  empty_branch = emit_word(state, 3019898882);
  poll_at = compiler.state_get(state, 136);
  drop emit_word(state, 3107979595);
  drop emit_word(state, 2316042603);
  busy_branch = emit_word(state, 3036676107);
  drop patch_short_branch(state, busy_branch, poll_at, 3036676107);
  drop emit_word(state, 960495659);
  drop emit_word(state, 3103785259);
  drop emit_word(state, 2432697377);
  drop emit_word(state, 3506439234);
  repeat_branch = emit_word(state, 335544320);
  drop patch_branch(state, repeat_branch, loop_at, 0);
  drop patch_short_branch(state, empty_branch, compiler.state_get(state, 136), 3019898882);
  drop emit_word(state, 2852979680);
  drop emit_push(state, 0);
  return 0;
}

fn emit_qemu_run(state) {
  drop emit_word(state, 2432697336);
  drop emit_word(state, 2853372921);
  drop emit_word(state, 2853438458);
  drop emit_word(state, 2853503995);
  drop emit_word(state, 2853569532);
  drop emit_word(state, 3594452992);
  drop emit_word(state, 2432697119);
  drop emit_word(state, 2853766131);
  drop emit_word(state, 2853831668);
  drop emit_word(state, 2853897205);
  drop emit_word(state, 2853962742);
  return 0;
}

fn emit_qemu_uart_byte(state, byte) {
  let poll_at = compiler.state_get(state, 136);
  let busy_branch = 0;

  drop emit_word(state, 3107985707);
  drop emit_word(state, 168558955);
  busy_branch = emit_word(state, 889192459);
  drop patch_short_branch(state, busy_branch, poll_at, 889192459);
  drop emit_move(state, 11, byte);
  drop emit_word(state, 3103785259);
  return 0;
}

fn emit_qemu_ready(state) {
  drop emit_move(state, 9, 150994944);
  drop emit_move(state, 12, 32);
  drop emit_qemu_uart_byte(state, 103);
  drop emit_qemu_uart_byte(state, 97);
  drop emit_qemu_uart_byte(state, 117);
  drop emit_qemu_uart_byte(state, 116);
  drop emit_qemu_uart_byte(state, 45);
  drop emit_qemu_uart_byte(state, 111);
  drop emit_qemu_uart_byte(state, 115);
  drop emit_qemu_uart_byte(state, 58);
  drop emit_qemu_uart_byte(state, 32);
  drop emit_qemu_uart_byte(state, 114);
  drop emit_qemu_uart_byte(state, 101);
  drop emit_qemu_uart_byte(state, 97);
  drop emit_qemu_uart_byte(state, 100);
  drop emit_qemu_uart_byte(state, 121);
  drop emit_qemu_uart_byte(state, 10);
  return 0;
}

fn write_header(state) {
  let output = compiler.state_get(state, 24);

  store32(1179403647, output);
  store32(65794, add(output, 4));
  store32(0, add(output, 8));
  store32(0, add(output, 12));
  store32(11993090, add(output, 16));
  store32(1, add(output, 20));
  store32(4194424, add(output, 24));
  store32(0, add(output, 28));
  store32(64, add(output, 32));
  store32(0, add(output, 36));
  store32(0, add(output, 40));
  store32(0, add(output, 44));
  store32(0, add(output, 48));
  store32(3670080, add(output, 52));
  store32(1, add(output, 56));
  store32(0, add(output, 60));
  store32(1, add(output, 64));
  store32(5, add(output, 68));
  store32(0, add(output, 72));
  store32(0, add(output, 76));
  store32(4194304, add(output, 80));
  store32(0, add(output, 84));
  store32(4194304, add(output, 88));
  store32(0, add(output, 92));
  store32(0, add(output, 96));
  store32(0, add(output, 100));
  store32(0, add(output, 104));
  store32(0, add(output, 108));
  store32(4096, add(output, 112));
  store32(0, add(output, 116));
  return 0;
}

fn emit_entry(state, platform) {
  let entry_call = 0;

  if eq(platform, 1) {
    drop compiler.state_set(state, 152, compiler.state_get(state, 24));
    drop compiler.state_set(state, 16, compiler.state_get(state, 24));
    drop emit_word(state, 268435478);
    drop emit_move(state, 0, 1207959552);
    drop emit_word(state, 2432696351);
    drop emit_word(state, 3510895615);
    drop emit_word(state, 2432697331);
    drop emit_word(state, 2436893684);
    drop emit_word(state, 2436892661);
    drop emit_qemu_wait_setup(state);
    entry_call = emit_word(state, 2483027968);
    drop emit_pop(state, 0);
    drop emit_qemu_halt(state);
  } else {
    if eq(platform, 2) {
      drop compiler.state_set(state, 152, compiler.state_get(state, 24));
      drop compiler.state_set(state, 16, compiler.state_get(state, 24));
      drop emit_word(state, 2854093815);
      drop emit_move(state, 0, 1206910976);
      drop emit_word(state, 2432696351);
      drop emit_word(state, 3510895615);
      drop emit_word(state, 2432697331);
      drop emit_word(state, 2436893684);
      drop emit_word(state, 2436892661);
      entry_call = emit_word(state, 2483027968);
      drop emit_pop(state, 0);
      drop emit_word(state, 3592356576);
    } else {
      drop write_header(state);
      drop compiler.state_set(state, 152, add(compiler.state_get(state, 24), 120));
      drop compiler.state_set(state, 16, compiler.state_get(state, 152));
      drop emit_word(state, 3510895615);
      drop emit_word(state, 2432697331);
      drop emit_word(state, 2436893684);
      drop emit_word(state, 2436892661);
      entry_call = emit_word(state, 2483027968);
      drop emit_pop(state, 0);
      drop emit_move(state, 8, 93);
      drop emit_word(state, 3556769793);
    }
  }

  return entry_call;
}

