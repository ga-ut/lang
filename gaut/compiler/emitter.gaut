fn emit_word(state, value) {
  let cursor = compiler.state_get(state, 16);

  if lt(sub(compiler.state_get(state, 128), cursor), 4) {
    drop compiler.fail(state);
  }

  store32(value, cursor);
  drop compiler.state_set(state, 16, add(cursor, 4));
  drop compiler.state_set(state, 136, add(compiler.state_get(state, 136), 1));
  return sub(compiler.state_get(state, 136), 1);
}

fn patch_word(state, index, value) {
  store32(value, add(compiler.state_get(state, 152), mul(index, 4)));
  return 0;
}

fn patch_branch(state, index, destination, link) {
  let instruction = 0x14000000;

  if link {
    instruction = 0x94000000;
  }

  instruction = bitor(instruction, bitand(sub(destination, index), 0x3ffffff));
  drop patch_word(state, index, instruction);
  return 0;
}

fn patch_zero_branch(state, index, destination) {
  let delta = bitand(sub(destination, index), 0x7ffff);
  drop patch_word(state, index, bitor(0xb4000000, shl(delta, 5)));
  return 0;
}

fn patch_short_branch(state, index, destination, instruction) {
  let delta = bitand(sub(destination, index), 0x7ffff);
  drop patch_word(state, index, bitor(instruction, shl(delta, 5)));
  return 0;
}

fn emit_move(state, register, value) {
  let index = 1;
  let chunk = bitand(value, 0xffff);

  drop emit_word(state, bitor(bitor(0xd2800000, shl(chunk, 5)), register));

  while lt(index, 4) {
    chunk = bitand(shr(value, mul(index, 16)), 0xffff);
    if chunk {
      drop emit_word(state, bitor(bitor(bitor(0xf2800000, shl(index, 21)), shl(chunk, 5)), register));
    }
    index = add(index, 1);
  }

  return 0;
}

fn pending_kind(state) {
  return compiler.state_get(state, 200);
}

fn pending_value(state) {
  return compiler.state_get(state, 208);
}

fn pending_set(state, kind, value) {
  drop compiler.state_set(state, 200, kind);
  drop compiler.state_set(state, 208, value);
  return 0;
}

fn reset_pending(state) {
  drop pending_set(state, 0, 0);
  return 0;
}

fn emit_pending(state, register) {
  # Kinds are a deferred constant, local load, or result already in x0.
  let kind = pending_kind(state);
  let value = pending_value(state);

  if eq(kind, 1) {
    drop emit_move(state, register, value);
  } else {
    if eq(kind, 2) {
      drop emit_word(
        state,
        bitor(bitor(bitor(0xf9400000, shl(value, 10)), shl(19, 5)), register)
      );
    } else {
      if eq(kind, 3) {
        if eq(register, 0) {
        } else {
          drop emit_word(state, bitor(0xaa0003e0, register));
        }
      } else {
        drop compiler.fail(state);
      }
    }
  }

  drop reset_pending(state);
  return 0;
}

fn flush_pending(state) {
  if pending_kind(state) {
    drop emit_pending(state, 0);
    drop emit_push(state, 0);
  }

  return 0;
}

fn emit_push(state, register) {
  drop emit_word(state, bitor(bitor(0xf9000000, shl(20, 5)), register));
  drop emit_word(state, 0x91002294);
  return 0;
}

fn emit_pop(state, register) {
  if pending_kind(state) {
    drop emit_pending(state, register);
  } else {
    drop emit_word(state, 0xd1002294);
    drop emit_word(state, bitor(bitor(0xf9400000, shl(20, 5)), register));
  }
  return 0;
}

fn emit_constant(state, value) {
  drop flush_pending(state);
  drop pending_set(state, 1, value);
  return 0;
}

fn emit_local_get(state, slot) {
  drop flush_pending(state);
  drop pending_set(state, 2, slot);
  return 0;
}

fn emit_local_set(state, slot) {
  drop emit_pop(state, 0);
  drop emit_word(state, bitor(bitor(0xf9000000, shl(slot, 10)), shl(19, 5)));
  return 0;
}

fn emit_memory_base(state, offset) {
  drop flush_pending(state);
  drop emit_move(state, 0, add(0x10000, offset));
  drop emit_word(state, 0x8b000260);
  drop emit_push(state, 0);
  return 0;
}

fn emit_binary(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop pending_set(state, 3, 0);
  return 0;
}

fn emit_compare(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 0xeb01001f);
  drop emit_word(state, instruction);
  drop pending_set(state, 3, 0);
  return 0;
}

fn emit_load(state, instruction) {
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  drop pending_set(state, 3, 0);
  return 0;
}

fn emit_store(state, instruction) {
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, instruction);
  return 0;
}

fn emit_host_call(state, number, outputs) {
  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 8, number);
  drop emit_word(state, 0xd4000001);
  if outputs {
    drop pending_set(state, 3, 0);
  }
  return 0;
}

fn emit_qemu_halt(state) {
  let wait_at = 0;
  let branch = 0;

  drop emit_move(state, 0, 0x84000008);
  drop emit_word(state, 0xd4000002);
  wait_at = compiler.state_get(state, 136);
  drop emit_word(state, 0xd503205f);
  branch = emit_word(state, 0x14000000);
  drop patch_branch(state, branch, wait_at, 0);
  return 0;
}

fn emit_branch_register(state, register) {
  drop emit_word(state, bitor(0xd61f0000, shl(register, 5)));
  return 0;
}

fn emit_qemu_exit(state) {
  let shutdown_branch = 0;

  drop emit_pop(state, 0);
  drop emit_word(state, 0xf100001f);
  shutdown_branch = emit_word(state, 0x54000000);
  drop emit_branch_register(state, 22);
  drop patch_short_branch(state, shutdown_branch, compiler.state_get(state, 136), 0x54000000);
  drop emit_qemu_halt(state);
  return 0;
}

fn emit_qemu_wait_setup(state) {
  drop emit_move(state, 9, 0x8000000);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 0x3920852a);
  drop emit_move(state, 10, 128);
  drop emit_word(state, 0x3910852a);
  drop emit_move(state, 10, 2);
  drop emit_word(state, 0xb901052a);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 0xb900012a);

  drop emit_move(state, 9, 0x8010000);
  drop emit_move(state, 10, 255);
  drop emit_word(state, 0xb900052a);
  drop emit_move(state, 10, 1);
  drop emit_word(state, 0xb900012a);

  drop emit_move(state, 9, 0x9000000);
  drop emit_move(state, 10, 2047);
  drop emit_word(state, 0xb900452a);
  drop emit_move(state, 10, 80);
  drop emit_word(state, 0xb900392a);
  return 0;
}

fn emit_qemu_uart_read_byte(state) {
  let poll_at = compiler.state_get(state, 136);
  let ready_branch = 0;
  let arrived_branch = 0;
  let repeat_branch = 0;

  drop emit_word(state, 0xb940192b);
  drop emit_word(state, 0xa0d016b);
  ready_branch = emit_word(state, 0x3400000b);
  drop emit_word(state, 0xb900452e);
  drop emit_word(state, 0xb940192b);
  drop emit_word(state, 0xa0d016b);
  arrived_branch = emit_word(state, 0x3400000b);
  drop emit_word(state, 0xd503207f);
  repeat_branch = emit_word(state, 0x14000000);
  drop patch_branch(state, repeat_branch, poll_at, 0);
  drop patch_short_branch(state, ready_branch, compiler.state_get(state, 136), 0x3400000b);
  drop patch_short_branch(state, arrived_branch, compiler.state_get(state, 136), 0x3400000b);
  drop emit_word(state, 0xb940012b);
  return 0;
}

fn emit_qemu_read(state) {
  let header_loop = 0;
  let header_done = 0;
  let header_repeat = 0;
  let valid_branch = 0;
  let body_loop = 0;
  let body_done = 0;
  let body_repeat = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_move(state, 9, 0x9000000);
  drop emit_move(state, 10, 0);
  drop emit_move(state, 12, 16);
  drop emit_move(state, 13, 16);
  drop emit_move(state, 14, 80);

  header_loop = compiler.state_get(state, 136);
  drop emit_word(state, 0xeb0c015f);
  header_done = emit_word(state, 0x54000000);
  drop emit_qemu_uart_read_byte(state);
  drop emit_word(state, 0x382a682b);
  drop emit_word(state, 0x9100054a);
  header_repeat = emit_word(state, 0x14000000);
  drop patch_branch(state, header_repeat, header_loop, 0);
  drop patch_short_branch(state, header_done, compiler.state_get(state, 136), 0x54000000);

  drop emit_word(state, 0xf940042c);
  drop emit_word(state, 0x9100418c);
  drop emit_word(state, 0xeb02019f);
  valid_branch = emit_word(state, 0x54000009);
  drop emit_qemu_halt(state);
  drop patch_short_branch(state, valid_branch, compiler.state_get(state, 136), 0x54000009);

  body_loop = compiler.state_get(state, 136);
  drop emit_word(state, 0xeb0c015f);
  body_done = emit_word(state, 0x54000000);
  drop emit_qemu_uart_read_byte(state);
  drop emit_word(state, 0x382a682b);
  drop emit_word(state, 0x9100054a);
  body_repeat = emit_word(state, 0x14000000);
  drop patch_branch(state, body_repeat, body_loop, 0);
  drop patch_short_branch(state, body_done, compiler.state_get(state, 136), 0x54000000);

  drop emit_word(state, 0xaa0c03e0);
  drop pending_set(state, 3, 0);
  return 0;
}

fn emit_qemu_write(state) {
  let loop_at = 0;
  let empty_branch = 0;
  let poll_at = 0;
  let busy_branch = 0;
  let repeat_branch = 0;

  drop emit_pop(state, 2);
  drop emit_pop(state, 1);
  drop emit_pop(state, 0);
  drop emit_word(state, 0xaa0203ed);
  drop emit_move(state, 9, 0x9000000);
  drop emit_move(state, 12, 32);
  drop emit_word(state, 0x9100612a);

  loop_at = compiler.state_get(state, 136);
  empty_branch = emit_word(state, 0xb4000002);
  poll_at = compiler.state_get(state, 136);
  drop emit_word(state, 0xb940014b);
  drop emit_word(state, 0x8a0c016b);
  busy_branch = emit_word(state, 0xb500000b);
  drop patch_short_branch(state, busy_branch, poll_at, 0xb500000b);
  drop emit_word(state, 0x3940002b);
  drop emit_word(state, 0xb900012b);
  drop emit_word(state, 0x91000421);
  drop emit_word(state, 0xd1000442);
  repeat_branch = emit_word(state, 0x14000000);
  drop patch_branch(state, repeat_branch, loop_at, 0);
  drop patch_short_branch(state, empty_branch, compiler.state_get(state, 136), 0xb4000002);
  drop emit_word(state, 0xaa0d03e0);
  drop pending_set(state, 3, 0);
  return 0;
}

fn emit_call_image(state) {
  drop emit_word(state, 0x910003f8);
  drop emit_word(state, 0xaa1303f9);
  drop emit_word(state, 0xaa1403fa);
  drop emit_word(state, 0xaa1503fb);
  drop emit_word(state, 0xaa1603fc);
  drop emit_word(state, 0xd63f0000);
  drop emit_word(state, 0x9100031f);
  drop emit_word(state, 0xaa1903f3);
  drop emit_word(state, 0xaa1a03f4);
  drop emit_word(state, 0xaa1b03f5);
  drop emit_word(state, 0xaa1c03f6);
  drop pending_set(state, 3, 0);
  return 0;
}

fn write_header(state) {
  let output = compiler.state_get(state, 24);

  store32(0x464c457f, output);
  store32(0x10102, add(output, 4));
  store32(0, add(output, 8));
  store32(0, add(output, 12));
  store32(0xb70002, add(output, 16));
  store32(1, add(output, 20));
  store32(0x400078, add(output, 24));
  store32(0, add(output, 28));
  store32(64, add(output, 32));
  store32(0, add(output, 36));
  store32(0, add(output, 40));
  store32(0, add(output, 44));
  store32(0, add(output, 48));
  store32(0x380040, add(output, 52));
  store32(1, add(output, 56));
  store32(0, add(output, 60));
  store32(1, add(output, 64));
  store32(5, add(output, 68));
  store32(0, add(output, 72));
  store32(0, add(output, 76));
  store32(0x400000, add(output, 80));
  store32(0, add(output, 84));
  store32(0x400000, add(output, 88));
  store32(0, add(output, 92));
  store32(0, add(output, 96));
  store32(0, add(output, 100));
  store32(0, add(output, 104));
  store32(0, add(output, 108));
  store32(4096, add(output, 112));
  store32(0, add(output, 116));
  return 0;
}

fn emit_entry(state, platform) {
  let entry_call = 0;

  if eq(platform, 1) {
    drop compiler.state_set(state, 152, compiler.state_get(state, 24));
    drop compiler.state_set(state, 16, compiler.state_get(state, 24));
    drop emit_word(state, 0x10000016);
    drop emit_move(state, 0, 0x48000000);
    drop emit_word(state, 0x9100001f);
    drop emit_word(state, 0xd14403ff);
    drop emit_word(state, 0x910003f3);
    drop emit_word(state, 0x91400bf4);
    drop emit_word(state, 0x914007f5);
    drop emit_qemu_wait_setup(state);
    entry_call = emit_word(state, 0x94000000);
    drop emit_pop(state, 0);
    drop emit_qemu_halt(state);
  } else {
    if eq(platform, 2) {
      drop compiler.state_set(state, 152, compiler.state_get(state, 24));
      drop compiler.state_set(state, 16, compiler.state_get(state, 24));
      drop emit_word(state, 0xaa1e03f7);
      drop emit_move(state, 0, 0x47f00000);
      drop emit_word(state, 0x9100001f);
      drop emit_word(state, 0xd14403ff);
      drop emit_word(state, 0x910003f3);
      drop emit_word(state, 0x91400bf4);
      drop emit_word(state, 0x914007f5);
      entry_call = emit_word(state, 0x94000000);
      drop emit_pop(state, 0);
      drop emit_word(state, 0xd61f02e0);
    } else {
      drop write_header(state);
      drop compiler.state_set(state, 152, add(compiler.state_get(state, 24), 120));
      drop compiler.state_set(state, 16, compiler.state_get(state, 152));
      drop emit_word(state, 0xd14403ff);
      drop emit_word(state, 0x910003f3);
      drop emit_word(state, 0x91400bf4);
      drop emit_word(state, 0x914007f5);
      entry_call = emit_word(state, 0x94000000);
      drop emit_pop(state, 0);
      drop emit_move(state, 8, 93);
      drop emit_word(state, 0xd4000001);
    }
  }

  return entry_call;
}
