fn request_u64(address) {
  let index = 0;
  let value = 0;

  while lt(index, 8) {
    value = bitor(value, shl(load8(add(address, index)), mul(index, 8)));
    index = add(index, 1);
  }

  return value;
}

fn compile_request(source, input_size, output, state) {
  let info = 0;
  let entry_call = 0;
  let file_size = 0;
  let cursor = 0;
  let profile = 0;
  let payload_size = 0;
  let unit_count = 0;
  let unit_index = 0;
  let request_cursor = 0;
  let request_end = 0;
  let name_address = 0;
  let name_length = 0;
  let unit_source = 0;
  let unit_source_size = 0;
  let module_index = 0;
  let function_count = 0;
  let clear_index = 0;


  if lt(input_size, 24) {
    drop compiler.fail(state);
  }
  if lt(131072, input_size) {
    drop compiler.fail(state);
  }
  profile = load64(source);
  payload_size = load64(add(source, 8));
  if eq(eq(input_size, add(payload_size, 16)), 0) {
    drop compiler.fail(state);
  }
  unit_count = load64(add(source, 16));
  if eq(unit_count, 0) {
    drop compiler.fail(state);
  }
  if lt(64, unit_count) {
    drop compiler.fail(state);
  }

  drop compiler.state_set(state, 24, output);
  drop compiler.state_set(state, 64, 0);
  drop compiler.state_set(state, 72, 0);
  drop compiler.state_set(state, 80, 0);
  drop compiler.state_set(state, 88, 0);
  drop compiler.state_set(state, 96, 0);
  drop compiler.state_set(state, 104, 0);
  drop compiler.state_set(state, 112, 0);
  drop compiler.state_set(state, 120, 0);
  drop compiler.state_set(state, 128, add(output, 262144));
  drop compiler.state_set(state, 136, 0);
  drop compiler.state_set(state, 144, 0);
  drop compiler.state_set(state, 152, 0);
  drop compiler.state_set(state, 160, 0);
  drop compiler.state_set(state, 168, 0);
  drop compiler.state_set(state, 176, 0);
  drop compiler.state_set(state, 184, 0);
  drop compiler.state_set(state, 192, 0);
  while lt(clear_index, 256) {
    store64(0, add(add(state, 52736), mul(clear_index, 32)));
    store64(0, add(add(state, 52744), mul(clear_index, 32)));
    store64(0, add(add(state, 52752), mul(clear_index, 32)));
    store64(0, add(add(state, 52760), mul(clear_index, 32)));
    store64(0, add(add(state, 60928), mul(clear_index, 8)));
    clear_index = add(clear_index, 1);
  }

  if eq(profile, 1) {
    drop compiler.state_set(state, 160, 0);
  } else {
    if eq(profile, 2) {
      drop compiler.state_set(state, 160, 1);
    } else {
      if eq(profile, 3) {
        drop compiler.state_set(state, 160, 2);
      } else {
        drop compiler.fail(state);
      }
    }
  }

  drop symbols.init_canonical(state);
  entry_call = emitter.emit_entry(state, compiler.state_get(state, 160));

  request_cursor = add(source, 24);
  request_end = add(source, input_size);
  while lt(unit_index, unit_count) {
    if lt(request_end, request_cursor) {
      drop compiler.fail(state);
    }
    if lt(sub(request_end, request_cursor), 16) {
      drop compiler.fail(state);
    }

    name_length = request_u64(request_cursor);
    unit_source_size = request_u64(add(request_cursor, 8));
    request_cursor = add(request_cursor, 16);
    if eq(name_length, 0) {
      drop compiler.fail(state);
    }
    if eq(unit_source_size, 0) {
      drop compiler.fail(state);
    }
    if lt(sub(request_end, request_cursor), name_length) {
      drop compiler.fail(state);
    }

    name_address = request_cursor;
    request_cursor = add(request_cursor, name_length);
    if lt(sub(request_end, request_cursor), unit_source_size) {
      drop compiler.fail(state);
    }

    unit_source = request_cursor;
    request_cursor = add(request_cursor, unit_source_size);
    module_index = symbols.module_add(state, name_address, name_length);
    drop compiler.state_set(state, 176, module_index);
    drop compiler.state_set(state, 0, unit_source);
    drop compiler.state_set(state, 8, add(unit_source, unit_source_size));
    drop lexer.next_token(state);
    function_count = compiler.state_get(state, 64);

    while eq(eq(compiler.state_get(state, 32), 0), 0) {
      if eq(eq(compiler.state_get(state, 32), 1), 0) {
        drop compiler.fail(state);
      }

      info = symbols.canonical_find(state, compiler.state_get(state, 40), compiler.state_get(state, 48));
      if eq(bitand(info, 255), 1) {
        drop parser.parse_function(state);
      } else {
        drop compiler.fail(state);
      }
    }

    if eq(function_count, compiler.state_get(state, 64)) {
      drop compiler.fail(state);
    }
    unit_index = add(unit_index, 1);
  }

  if eq(eq(request_cursor, request_end), 0) {
    drop compiler.fail(state);
  }

  if eq(compiler.state_get(state, 104), 0) {
    drop compiler.fail(state);
  }

  drop symbols.resolve_calls(state);
  drop symbols.reject_call_cycles(state);
  drop emitter.patch_branch(state, entry_call, compiler.state_get(state, 144), 1);

  file_size = bitand(add(sub(compiler.state_get(state, 16), output), 4095), 18446744073709547520);
  if lt(262144, file_size) {
    drop compiler.fail(state);
  }

  if eq(compiler.state_get(state, 160), 0) {
    store64(file_size, add(output, 96));
    store64(file_size, add(output, 104));
  }
  cursor = compiler.state_get(state, 16);
  while lt(cursor, add(output, file_size)) {
    store8(0, cursor);
    cursor = add(cursor, 1);
  }

  if eq(compiler.state_get(state, 160), 2) {
    platform.run(output);
  } else {
    drop host.write(1, output, file_size);
  }

  return file_size;
}
