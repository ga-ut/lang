fn copy_bytes(source, destination, length) {
  let index = 0;

  while lt(index, length) {
    store8(load8(add(source, index)), add(destination, index));
    index = add(index, 1);
  }

  return 0;
}

fn write_u64(address, value) {
  let index = 0;

  while lt(index, 8) {
    store8(bitand(shr(value, mul(index, 8)), 0xff), add(address, index));
    index = add(index, 1);
  }

  return 0;
}

fn catalog_capacity() {
  return 64;
}

fn catalog_entry_size() {
  return 112;
}

fn source_record_size() {
  return 32768;
}

fn record_checksum(record) {
  let offset = 0;
  let checksum = 0xcbf29ce484222325;

  while lt(offset, source_record_size()) {
    checksum = mul(bitxor(checksum, load8(add(record, offset))), 0x100000001b3);
    offset = add(offset, 1);
  }

  return checksum;
}

fn catalog_entry(catalog, index) {
  return add(catalog, mul(index, catalog_entry_size()));
}

fn clear(catalog) {
  let offset = 0;
  let size = mul(catalog_capacity(), catalog_entry_size());

  while lt(offset, size) {
    store64(0, add(catalog, offset));
    offset = add(offset, 8);
  }

  return 0;
}

fn clear_record(record) {
  let offset = 0;

  while lt(offset, source_record_size()) {
    store64(0, add(record, offset));
    offset = add(offset, 8);
  }

  return 0;
}

fn record_valid(record) {
  let valid = eq(load64(record), 1);
  let name_length = load64(add(record, 8));
  let source_length = load64(add(record, 16));

  if bitand(lt(0, name_length), lt(name_length, 65)) {
  } else {
    valid = 0;
  }
  if bitand(lt(0, source_length), lt(source_length, 32681)) {
  } else {
    valid = 0;
  }
  if lt(source_record_size(), add(88, source_length)) {
    valid = 0;
  }
  if valid {
    valid = symbols.module_name_valid(add(record, 24), name_length);
  }

  return valid;
}

fn catalog_find(catalog, name, name_length) {
  let index = 0;
  let entry = 0;
  let result = 0;

  while bitand(eq(result, 0), lt(index, catalog_capacity())) {
    entry = catalog_entry(catalog, index);
    if bitand(load64(entry), eq(load64(add(entry, 8)), name_length)) {
      if symbols.span_equal(add(entry, 48), name_length, name, name_length) {
        result = entry;
      }
    }
    index = add(index, 1);
  }

  return result;
}

fn catalog_empty(catalog) {
  let index = 0;
  let entry = 0;
  let result = 0;

  while bitand(eq(result, 0), lt(index, catalog_capacity())) {
    entry = catalog_entry(catalog, index);
    if eq(load64(entry), 0) {
      store64(index, add(entry, 24));
      result = entry;
    }
    index = add(index, 1);
  }

  return result;
}

fn catalog_set(catalog, index, record) {
  let entry = catalog_entry(catalog, index);
  let name_length = load64(add(record, 8));

  store64(1, entry);
  store64(name_length, add(entry, 8));
  store64(load64(add(record, 16)), add(entry, 16));
  store64(index, add(entry, 24));
  store64(1, add(entry, 32));
  store64(record_checksum(record), add(entry, 40));
  drop copy_bytes(add(record, 24), add(entry, 48), name_length);
  return 0;
}

fn catalog_index(entry) {
  return load64(add(entry, 24));
}

fn record_matches_entry(record, entry) {
  let name_length = load64(add(entry, 8));
  let matches = record_valid(record);

  if eq(load64(add(record, 8)), name_length) {
  } else {
    matches = 0;
  }
  if eq(load64(add(record, 16)), load64(add(entry, 16))) {
  } else {
    matches = 0;
  }
  if eq(load64(add(entry, 32)), 1) {
  } else {
    matches = 0;
  }
  if eq(record_checksum(record), load64(add(entry, 40))) {
  } else {
    matches = 0;
  }
  if matches {
    matches = symbols.span_equal(add(record, 24), name_length, add(entry, 48), name_length);
  }

  return matches;
}

fn load_catalog(catalog, scratch) {
  let index = 0;
  let name_length = 0;

  while lt(index, catalog_capacity()) {
    store64(index, add(scratch, source_record_size()));
    if platform.workspace_load(scratch) {
      if record_valid(scratch) {
        name_length = load64(add(scratch, 8));
        if eq(catalog_find(catalog, add(scratch, 24), name_length), 0) {
          drop catalog_set(catalog, index, scratch);
        }
      }
    }
    index = add(index, 1);
  }

  return 0;
}

fn store_request(source, input_size, scratch, catalog, state) {
  let name_length = 0;
  let source_length = 0;
  let name = 0;
  let source_bytes = 0;
  let entry = 0;
  let index = 0;

  if lt(input_size, 50) {
    drop compiler.fail(state);
  }
  if eq(eq(input_size, add(load64(add(source, 8)), 16)), 0) {
    drop compiler.fail(state);
  }
  if eq(eq(load64(source), 3), 0) {
    drop compiler.fail(state);
  }
  if eq(eq(load64(add(source, 16)), 2), 0) {
    drop compiler.fail(state);
  }
  if eq(eq(load64(add(source, 24)), 1), 0) {
    drop compiler.fail(state);
  }

  name_length = request.request_u64(add(source, 32));
  source_length = request.request_u64(add(source, 40));
  if bitand(lt(0, name_length), lt(name_length, 65)) {
  } else {
    drop compiler.fail(state);
  }
  if bitand(lt(0, source_length), lt(source_length, 32681)) {
  } else {
    drop compiler.fail(state);
  }
  if eq(eq(input_size, add(add(48, name_length), source_length)), 0) {
    drop compiler.fail(state);
  }

  name = add(source, 48);
  source_bytes = add(name, name_length);
  if eq(symbols.module_name_valid(name, name_length), 0) {
    drop compiler.fail(state);
  }

  entry = catalog_find(catalog, name, name_length);
  if eq(entry, 0) {
    entry = catalog_empty(catalog);
  }
  if eq(entry, 0) {
    drop compiler.fail(state);
  }
  index = catalog_index(entry);

  drop clear_record(scratch);
  store64(1, scratch);
  store64(name_length, add(scratch, 8));
  store64(source_length, add(scratch, 16));
  drop copy_bytes(name, add(scratch, 24), name_length);
  drop copy_bytes(source_bytes, add(scratch, 88), source_length);
  store64(index, add(scratch, source_record_size()));
  drop platform.workspace_save(scratch);
  drop catalog_set(catalog, index, scratch);

  store64(4211832317539606887, add(state, 64912));
  store64(2334102049055339296, add(state, 64920));
  store8(10, add(state, 64928));
  drop host.write(1, add(state, 64912), 16);
  drop host.write(1, name, name_length);
  drop host.write(1, add(state, 64928), 1);
  return 0;
}

fn restore_request(source, input_size, scratch, catalog, state) {
  let name_length = 0;
  let name = 0;
  let entry = 0;
  let index = 0;
  let source_length = 0;
  let restored_size = 0;

  if lt(input_size, 33) {
    drop compiler.fail(state);
  }
  if eq(eq(input_size, add(load64(add(source, 8)), 16)), 0) {
    drop compiler.fail(state);
  }
  if eq(eq(load64(source), 3), 0) {
    drop compiler.fail(state);
  }
  if eq(eq(load64(add(source, 16)), 3), 0) {
    drop compiler.fail(state);
  }

  name_length = request.request_u64(add(source, 24));
  if bitand(lt(0, name_length), lt(name_length, 65)) {
  } else {
    drop compiler.fail(state);
  }
  if eq(eq(input_size, add(32, name_length)), 0) {
    drop compiler.fail(state);
  }

  name = add(source, 32);
  if eq(symbols.module_name_valid(name, name_length), 0) {
    drop compiler.fail(state);
  }
  entry = catalog_find(catalog, name, name_length);
  if eq(entry, 0) {
    drop compiler.fail(state);
  }
  index = catalog_index(entry);
  store64(index, add(scratch, source_record_size()));
  if eq(platform.workspace_load(scratch), 0) {
    drop compiler.fail(state);
  }
  if eq(record_matches_entry(scratch, entry), 0) {
    drop compiler.fail(state);
  }

  source_length = load64(add(entry, 16));
  restored_size = add(add(48, name_length), source_length);
  store64(3, source);
  store64(sub(restored_size, 16), add(source, 8));
  store64(1, add(source, 16));
  store64(1, add(source, 24));
  store64(name_length, add(source, 32));
  store64(source_length, add(source, 40));
  drop copy_bytes(add(scratch, 24), add(source, 48), name_length);
  drop copy_bytes(add(scratch, 88), add(add(source, 48), name_length), source_length);
  return restored_size;
}

fn append_workspace_unit(source, request_size, record, state) {
  let name_length = load64(add(record, 8));
  let source_length = load64(add(record, 16));
  let record_size = add(add(16, name_length), source_length);
  let cursor = 0;

  if lt(131072, add(request_size, record_size)) {
    drop compiler.fail(state);
  }

  cursor = add(source, request_size);
  drop write_u64(cursor, name_length);
  drop write_u64(add(cursor, 8), source_length);
  drop copy_bytes(add(record, 24), add(cursor, 16), name_length);
  drop copy_bytes(add(record, 88), add(add(cursor, 16), name_length), source_length);
  return add(request_size, record_size);
}

fn restore_workspace_request(source, scratch, catalog, state) {
  let index = 0;
  let entry = 0;
  let unit_count = 0;
  let request_size = 32;

  while lt(index, catalog_capacity()) {
    entry = catalog_entry(catalog, index);
    if load64(entry) {
      store64(index, add(scratch, source_record_size()));
      if eq(platform.workspace_load(scratch), 0) {
        drop compiler.fail(state);
      }
      if eq(record_matches_entry(scratch, entry), 0) {
        drop compiler.fail(state);
      }
      request_size = append_workspace_unit(source, request_size, scratch, state);
      unit_count = add(unit_count, 1);
    }
    index = add(index, 1);
  }

  if eq(unit_count, 0) {
    drop compiler.fail(state);
  }

  store64(sub(request_size, 16), add(source, 8));
  store64(1, add(source, 16));
  store64(unit_count, add(source, 24));
  return request_size;
}
