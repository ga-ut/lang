fn span_equal(left, left_length, right, right_length) {
  let index = 0;
  let equal = eq(left_length, right_length);

  while bitand(equal, lt(index, left_length)) {
    if eq(eq(load8(add(left, index)), load8(add(right, index))), 0) {
      equal = 0;
    }
    index = add(index, 1);
  }

  return equal;
}

fn span_has_dot(address, length) {
  let index = 0;
  let found = 0;

  while bitand(eq(found, 0), lt(index, length)) {
    if eq(load8(add(address, index)), 46) {
      found = 1;
    }
    index = add(index, 1);
  }

  return found;
}

fn module_name_valid(address, length) {
  let index = 0;
  let expect_start = 1;
  let valid = lt(0, length);
  let byte = 0;

  while bitand(valid, lt(index, length)) {
    byte = load8(add(address, index));
    if expect_start {
      if lexer.is_name_start(byte) {
        expect_start = 0;
      } else {
        valid = 0;
      }
    } else {
      if eq(byte, 46) {
        expect_start = 1;
      } else {
        if eq(lexer.is_name_continue(byte), 0) {
          valid = 0;
        }
      }
    }
    index = add(index, 1);
  }

  if expect_start {
    valid = 0;
  }
  return valid;
}

fn module_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, compiler.state_get(state, 168)), eq(result, 0)) {
    entry = add(add(state, 49152), mul(index, 16));
    if span_equal(address, length, load64(entry), load64(add(entry, 8))) {
      result = add(index, 1);
    }
    index = add(index, 1);
  }

  return result;
}

fn module_add(state, address, length) {
  let index = compiler.state_get(state, 168);
  let entry = 0;

  if eq(module_name_valid(address, length), 0) {
    drop compiler.fail(state);
  }
  if module_find(state, address, length) {
    drop compiler.fail(state);
  }
  if eq(lt(index, 64), 0) {
    drop compiler.fail(state);
  }

  entry = add(add(state, 49152), mul(index, 16));
  store64(address, entry);
  store64(length, add(entry, 8));
  drop compiler.state_set(state, 168, add(index, 1));
  return index;
}

fn canonical_add(state, first, second, length, info) {
  let entry = add(add(state, 4096), mul(compiler.state_get(state, 96), 32));

  store64(first, entry);
  store64(second, add(entry, 8));
  store64(length, add(entry, 16));
  store64(info, add(entry, 24));
  drop compiler.state_set(state, 96, add(compiler.state_get(state, 96), 1));
  return 0;
}

fn canonical_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, compiler.state_get(state, 96)), eq(result, 0)) {
    entry = add(add(state, 4096), mul(index, 32));
    if span_equal(address, length, entry, load64(add(entry, 16))) {
      result = load64(add(entry, 24));
    }
    index = add(index, 1);
  }

  return result;
}

fn function_add(state, address, length, arity, code_index, module_index) {
  let entry = 0;
  let index = compiler.state_get(state, 64);

  if eq(lt(index, 256), 0) {
    drop compiler.fail(state);
  }

  entry = add(add(state, 8192), mul(index, 32));
  store64(address, entry);
  store64(add(length, mul(module_index, 0x100000000)), add(entry, 8));
  store64(arity, add(entry, 16));
  store64(code_index, add(entry, 24));
  drop compiler.state_set(state, 64, add(index, 1));
  return index;
}

fn function_find_in_module(state, address, length, module_index) {
  let index = 0;
  let result = 0;
  let entry = 0;
  let packed = 0;

  while bitand(lt(index, compiler.state_get(state, 64)), eq(result, 0)) {
    entry = add(add(state, 8192), mul(index, 32));
    packed = load64(add(entry, 8));
    if eq(shr(packed, 32), module_index) {
      if span_equal(address, length, load64(entry), bitand(packed, 0xffffffff)) {
        result = entry;
      }
    }
    index = add(index, 1);
  }

  return result;
}

fn function_locals_set(state, function_index, local_count) {
  store64(local_count, add(add(state, 38912), mul(function_index, 8)));
  return 0;
}

fn function_find(state, address, length) {
  return function_find_in_module(state, address, length, compiler.state_get(state, 176));
}

fn function_resolve(state, address, length, current_module) {
  let index = 0;
  let split = 0;
  let module = 0;
  let result = 0;

  while lt(index, length) {
    if eq(load8(add(address, index)), 46) {
      split = add(index, 1);
    }
    index = add(index, 1);
  }

  if split {
    if lt(split, length) {
      module = module_find(state, address, sub(split, 1));
      if module {
        result = function_find_in_module(
          state,
          add(address, split),
          sub(length, split),
          sub(module, 1)
        );
      }
    }
  } else {
    result = function_find_in_module(state, address, length, current_module);
  }

  return result;
}

fn local_add(state, address, length, kind, value) {
  let entry = 0;

  if eq(lt(compiler.state_get(state, 72), 256), 0) {
    drop compiler.fail(state);
  }

  entry = add(add(state, 16384), mul(compiler.state_get(state, 72), 32));
  store64(address, entry);
  store64(length, add(entry, 8));
  store64(kind, add(entry, 16));
  store64(value, add(entry, 24));
  drop compiler.state_set(state, 72, add(compiler.state_get(state, 72), 1));
  return 0;
}

fn local_find(state, address, length) {
  let index = 0;
  let result = 0;
  let entry = 0;

  while bitand(lt(index, compiler.state_get(state, 72)), eq(result, 0)) {
    entry = add(add(state, 16384), mul(index, 32));
    if span_equal(address, length, load64(entry), load64(add(entry, 8))) {
      result = entry;
    }
    index = add(index, 1);
  }

  return result;
}

fn init_canonical(state) {
  drop compiler.state_set(state, 96, 0);

  drop canonical_add(state, 28262, 0, 2, 16777217);
  drop canonical_add(state, 7628140, 0, 3, 16777218);
  drop canonical_add(state, 133532402673005, 0, 6, 16777219);
  drop canonical_add(state, 1886351972, 0, 4, 16777220);
  drop canonical_add(state, 26217, 0, 2, 16777221);
  drop canonical_add(state, 1702063205, 0, 4, 16777222);
  drop canonical_add(state, 435610544247, 0, 5, 16777223);
  drop canonical_add(state, 121437875889522, 0, 6, 16777224);

  drop canonical_add(state, 6579297, 0, 3, 33620496);
  drop canonical_add(state, 6452595, 0, 3, 33620497);
  drop canonical_add(state, 7107949, 0, 3, 33620498);
  drop canonical_add(state, 110425244199266, 0, 6, 33620499);
  drop canonical_add(state, 491496171874, 0, 5, 33620500);
  drop canonical_add(state, 125823087831394, 0, 6, 33620501);
  drop canonical_add(state, 7104627, 0, 3, 33620502);
  drop canonical_add(state, 7497843, 0, 3, 33620503);
  drop canonical_add(state, 29029, 0, 2, 33620504);
  drop canonical_add(state, 29804, 0, 2, 33620505);
  drop canonical_add(state, 242202275692, 0, 5, 33620256);
  drop canonical_add(state, 55196308828012, 0, 6, 33620257);
  drop canonical_add(state, 57408216985452, 0, 6, 33620258);
  drop canonical_add(state, 62008362759283, 0, 6, 33554979);
  drop canonical_add(state, 14130259640153203, 0, 7, 33554980);
  drop canonical_add(state, 14696508128457843, 0, 7, 33554981);
  drop canonical_add(state, 7018141138174570344, 100, 9, 33620800);
  drop canonical_add(state, 7598266562733371240, 25972, 10, 33620801);
  drop canonical_add(state, 7599935621384335208, 116, 9, 33554754);
  drop canonical_add(state, 7020383252702323043, 25959, 10, 33620293);
  return 0;
}

fn call_edge(state, caller, callee) {
  let edge = add(add(state, 52736), add(mul(caller, 32), mul(shr(callee, 6), 8)));
  let mask = shl(1, bitand(callee, 63));
  let indegree = add(add(state, 60928), mul(callee, 8));

  if eq(bitand(load64(edge), mask), 0) {
    store64(bitor(load64(edge), mask), edge);
    store64(add(load64(indegree), 1), indegree);
  }
  return 0;
}

fn call_add(state, address, length, module_index, arguments, branch, callee) {
  let index = compiler.state_get(state, 192);
  let entry = 0;
  let callee_index = 0;

  if callee {
    callee_index = shr(sub(callee, add(state, 8192)), 5);
    drop call_edge(state, compiler.state_get(state, 184), callee_index);
  } else {
    if eq(lt(index, 64), 0) {
      drop compiler.fail(state);
    }
    entry = add(add(state, 50176), mul(index, 32));
    store64(address, entry);
    store64(length, add(entry, 8));
    store64(
      add(module_index, add(shl(compiler.state_get(state, 184), 8), shl(arguments, 16))),
      add(entry, 16)
    );
    store64(branch, add(entry, 24));
    drop compiler.state_set(state, 192, add(index, 1));
  }
  return 0;
}

fn resolve_calls(state) {
  let index = 0;
  let entry = 0;
  let callee = 0;
  let metadata = 0;

  while lt(index, compiler.state_get(state, 192)) {
    entry = add(add(state, 50176), mul(index, 32));
    metadata = load64(add(entry, 16));
    callee = function_resolve(
      state,
      load64(entry),
      load64(add(entry, 8)),
      bitand(metadata, 255)
    );
    if eq(callee, 0) {
      drop compiler.fail(state);
    }
    if eq(eq(load64(add(callee, 16)), bitand(shr(metadata, 16), 255)), 0) {
      drop compiler.fail(state);
    }
    drop emitter.patch_branch(state, load64(add(entry, 24)), load64(add(callee, 24)), 1);
    drop call_edge(
      state,
      bitand(shr(metadata, 8), 255),
      shr(sub(callee, add(state, 8192)), 5)
    );
    index = add(index, 1);
  }

  return 0;
}

fn mark_reachable_functions(state) {
  let function_count = compiler.state_get(state, 64);
  let function_index = 0;
  let main_index = 0;
  let found_main = 0;
  let queue_head = 0;
  let queue_tail = 1;
  let caller = 0;
  let callee = 0;
  let edge = 0;
  let mask = 0;
  let reachable = 0;

  while lt(function_index, function_count) {
    if eq(
      load64(add(add(add(state, 8192), mul(function_index, 32)), 24)),
      compiler.state_get(state, 144)
    ) {
      main_index = function_index;
      found_main = 1;
    }
    function_index = add(function_index, 1);
  }
  if eq(found_main, 0) {
    drop compiler.fail(state);
  }

  store64(1, add(add(state, 45056), mul(main_index, 8)));
  store64(main_index, add(state, 47104));
  while lt(queue_head, queue_tail) {
    caller = load64(add(add(state, 47104), mul(queue_head, 8)));
    callee = 0;
    while lt(callee, function_count) {
      edge = add(add(state, 52736), add(mul(caller, 32), mul(shr(callee, 6), 8)));
      mask = shl(1, bitand(callee, 63));
      if bitand(load64(edge), mask) {
        reachable = add(add(state, 45056), mul(callee, 8));
        if eq(load64(reachable), 0) {
          store64(1, reachable);
          if eq(lt(queue_tail, function_count), 0) {
            drop compiler.fail(state);
          }
          store64(callee, add(add(state, 47104), mul(queue_tail, 8)));
          queue_tail = add(queue_tail, 1);
        }
      }
      callee = add(callee, 1);
    }
    queue_head = add(queue_head, 1);
  }

  return main_index;
}

fn function_index_at_code(state, code_index) {
  let function_index = 0;
  let result = 0;

  while bitand(eq(result, 0), lt(function_index, compiler.state_get(state, 64))) {
    if eq(
      load64(add(add(add(state, 8192), mul(function_index, 32)), 24)),
      code_index
    ) {
      result = add(function_index, 1);
    }
    function_index = add(function_index, 1);
  }

  return result;
}

fn compact_reachable_functions(state) {
  let function_count = compiler.state_get(state, 64);
  let old_code_end = compiler.state_get(state, 136);
  let main_index = mark_reachable_functions(state);
  let function_index = 0;
  let function_entry = 0;
  let old_start = 0;
  let old_end = 0;
  let new_start = 0;
  let new_end = 0;
  let old_index = 0;
  let new_index = 0;
  let instruction = 0;
  let immediate = 0;
  let old_target = 0;
  let target_result = 0;
  let target_index = 0;
  let new_target = 0;

  if eq(function_count, 0) {
    drop compiler.fail(state);
  }
  new_end = load64(add(add(state, 8192), 24));

  while lt(function_index, function_count) {
    store64(0, add(add(state, 47104), mul(function_index, 8)));
    function_index = add(function_index, 1);
  }

  function_index = 0;
  while lt(function_index, function_count) {
    function_entry = add(add(state, 8192), mul(function_index, 32));
    old_start = load64(add(function_entry, 24));
    if lt(add(function_index, 1), function_count) {
      old_end = load64(add(add(function_entry, 32), 24));
    } else {
      old_end = old_code_end;
    }

    if load64(add(add(state, 45056), mul(function_index, 8))) {
      store64(new_end, add(add(state, 47104), mul(function_index, 8)));
      new_end = add(new_end, sub(old_end, old_start));
    }
    function_index = add(function_index, 1);
  }

  function_index = 0;
  while lt(function_index, function_count) {
    if load64(add(add(state, 45056), mul(function_index, 8))) {
      function_entry = add(add(state, 8192), mul(function_index, 32));
      old_start = load64(add(function_entry, 24));
      if lt(add(function_index, 1), function_count) {
        old_end = load64(add(add(function_entry, 32), 24));
      } else {
        old_end = old_code_end;
      }
      new_start = load64(add(add(state, 47104), mul(function_index, 8)));
      old_index = old_start;
      new_index = new_start;

      while lt(old_index, old_end) {
        instruction = load32(add(compiler.state_get(state, 152), mul(old_index, 4)));
        drop emitter.patch_word(state, new_index, instruction);

        if eq(bitand(instruction, 0xfc000000), 0x94000000) {
          immediate = bitand(instruction, 0x3ffffff);
          if bitand(immediate, 0x2000000) {
            old_target = sub(old_index, sub(0x4000000, immediate));
          } else {
            old_target = add(old_index, immediate);
          }
          target_result = function_index_at_code(state, old_target);
          if eq(target_result, 0) {
            drop compiler.fail(state);
          }
          target_index = sub(target_result, 1);
          new_target = load64(add(add(state, 47104), mul(target_index, 8)));
          if eq(load64(add(add(state, 45056), mul(target_index, 8))), 0) {
            drop compiler.fail(state);
          }
          drop emitter.patch_branch(state, new_index, new_target, 1);
        }

        old_index = add(old_index, 1);
        new_index = add(new_index, 1);
      }
    }
    function_index = add(function_index, 1);
  }

  function_index = 0;
  while lt(function_index, function_count) {
    store64(
      load64(add(add(state, 47104), mul(function_index, 8))),
      add(add(add(state, 8192), mul(function_index, 32)), 24)
    );
    function_index = add(function_index, 1);
  }

  drop compiler.state_set(state, 144, load64(add(add(state, 47104), mul(main_index, 8))));
  drop compiler.state_set(state, 136, new_end);
  drop compiler.state_set(state, 16, add(compiler.state_get(state, 152), mul(new_end, 4)));
  return 0;
}

fn allocate_local_slots(state) {
  let function_count = compiler.state_get(state, 64);
  let callee = 0;
  let processed = 0;
  let candidate = 0;
  let found = 0;
  let edge = 0;
  let mask = 0;
  let depth = 0;
  let next_depth = 0;
  let local_count = 0;
  let level_address = 0;
  let level = 0;
  let base = 0;
  let function_index = 0;
  let code_index = 0;
  let code_end = 0;
  let instruction = 0;
  let signature = 0;
  let relative_slot = 0;
  let absolute_slot = 0;

  # Topological depth gives every caller and reachable callee different ranges.
  # Functions at the same depth cannot be active together and share one range.
  while lt(processed, function_count) {
    candidate = 0;
    found = 0;
    while bitand(eq(found, 0), lt(candidate, function_count)) {
      if eq(load64(add(add(state, 60928), mul(candidate, 8))), 0) {
        found = 1;
      } else {
        candidate = add(candidate, 1);
      }
    }
    if eq(found, 0) {
      drop compiler.fail(state);
    }

    depth = load64(add(add(state, 40960), mul(candidate, 8)));
    local_count = load64(add(add(state, 38912), mul(candidate, 8)));
    level_address = add(add(state, 43008), mul(depth, 8));
    if lt(load64(level_address), local_count) {
      store64(local_count, level_address);
    }

    store64(0xffffffffffffffff, add(add(state, 60928), mul(candidate, 8)));
    processed = add(processed, 1);
    callee = 0;
    while lt(callee, function_count) {
      edge = add(add(state, 52736), add(mul(candidate, 32), mul(shr(callee, 6), 8)));
      mask = shl(1, bitand(callee, 63));
      if bitand(load64(edge), mask) {
        if eq(eq(load64(add(add(state, 60928), mul(callee, 8))), 0xffffffffffffffff), 0) {
          next_depth = add(depth, 1);
          if lt(load64(add(add(state, 40960), mul(callee, 8))), next_depth) {
            store64(next_depth, add(add(state, 40960), mul(callee, 8)));
          }
          store64(
            sub(load64(add(add(state, 60928), mul(callee, 8))), 1),
            add(add(state, 60928), mul(callee, 8))
          );
        }
      }
      callee = add(callee, 1);
    }
  }

  level = 0;
  base = 0;
  while lt(level, function_count) {
    level_address = add(add(state, 43008), mul(level, 8));
    local_count = load64(level_address);
    store64(base, level_address);
    base = add(base, local_count);
    if lt(512, base) {
      drop compiler.fail(state);
    }
    level = add(level, 1);
  }

  # Local instructions were emitted with function-relative slots. Patch only
  # 64-bit local loads and stores whose base register is the Gaut local base.
  function_index = 0;
  while lt(function_index, function_count) {
    depth = load64(add(add(state, 40960), mul(function_index, 8)));
    base = load64(add(add(state, 43008), mul(depth, 8)));
    code_index = load64(add(add(add(state, 8192), mul(function_index, 32)), 24));
    if lt(add(function_index, 1), function_count) {
      code_end = load64(add(add(add(state, 8192), mul(add(function_index, 1), 32)), 24));
    } else {
      code_end = compiler.state_get(state, 136);
    }

    while lt(code_index, code_end) {
      instruction = load32(add(compiler.state_get(state, 152), mul(code_index, 4)));
      signature = bitand(instruction, 0xffc003e0);
      if bitor(eq(signature, 0xf9400260), eq(signature, 0xf9000260)) {
        relative_slot = bitand(shr(instruction, 10), 0xfff);
        absolute_slot = add(base, relative_slot);
        if eq(lt(absolute_slot, 512), 0) {
          drop compiler.fail(state);
        }
        instruction = bitor(bitand(instruction, 0xffc003ff), shl(absolute_slot, 10));
        drop emitter.patch_word(state, code_index, instruction);
      }
      code_index = add(code_index, 1);
    }
    function_index = add(function_index, 1);
  }

  return 0;
}
