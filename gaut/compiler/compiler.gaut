# Gaut 0.5 compiler, written in readable Gaut.
#
# This compiler validates Gaut source and directly emits either a static
# AArch64 Linux ELF or a freestanding raw image.

fn state_get(state, offset) {
  return load64(add(state, offset));
}

fn state_set(state, offset, value) {
  store64(value, add(state, offset));
  return 0;
}

fn fail(state) {
  drop host.write(2, add(state, 65000), 21);
  host.exit(2);
  return 0;
}

fn report_test(state, result) {
  store64(4211832317539606887, add(state, 64912));
  if result {
    store64(7018332753827820576, add(state, 64920));
    store64(44634041449, add(state, 64928));
  } else {
    store64(7021147503594927136, add(state, 64920));
    store64(44634043251, add(state, 64928));
  }
  drop host.write(1, add(state, 64912), 21);
  return 0;
}

fn main() {
  memory source 131072;
  memory output 262144;
  memory state 65536;
  memory catalog_memory 8192;
  let input_size = 0;
  let received = 49;
  let command = 0;
  let named_run = 0;
  let test_mode = 0;
  let fixed_point_mode = 0;
  let workspace_mode = 0;
  let result = 0;

  store64(7955925652160733543, add(state, 65000));
  store64(8030798176169255286, add(state, 65008));
  store64(44650689141, add(state, 65016));

  drop storage.clear(catalog_memory);
  drop storage.load_catalog(catalog_memory, source);
  drop platform.ready();
  input_size = host.read(0, source, 131072);
  while input_size {
    if bitand(eq(input_size, 16), bitand(eq(load64(source), 0), eq(load64(add(source, 8)), 0))) {
      host.exit(0);
    }

    if lt(input_size, 24) {
      drop fail(state);
    }
    command = load64(add(source, 16));
    named_run = 0;
    test_mode = eq(command, 4);
    fixed_point_mode = eq(command, 5);
    workspace_mode = eq(command, 6);

    if workspace_mode {
      if eq(load64(source), 3) {
        test_mode = 1;
      } else {
        if eq(load64(source), 2) {
          fixed_point_mode = 1;
        } else {
          drop fail(state);
        }
      }
      input_size = storage.restore_workspace_request(source, output, catalog_memory, state);
    }

    if test_mode {
      if eq(eq(load64(source), 3), 0) {
        drop fail(state);
      }
      store64(1, add(source, 16));
    }

    if fixed_point_mode {
      if eq(eq(load64(source), 2), 0) {
        drop fail(state);
      }
      store64(1, add(source, 16));
    }

    if eq(command, 2) {
      drop storage.store_request(source, input_size, output, catalog_memory, state);
    } else {
      if eq(command, 3) {
        input_size = storage.restore_request(source, input_size, output, catalog_memory, state);
        named_run = 1;
      }

      if bitand(eq(load64(source), 3), eq(named_run, 0)) {
        store64(4211832317539606887, add(state, 64944));
        store64(7311146929262785056, add(state, 64952));
        store8(100, add(state, 64960));
        store8(32, add(state, 64961));
        store8(received, add(state, 64962));
        store8(10, add(state, 64963));
        drop host.write(1, add(state, 64944), 20);
        received = add(received, 1);
      }

      result = request.compile_request(source, input_size, output, state, fixed_point_mode);
      if test_mode {
        drop report_test(state, result);
      }
      if fixed_point_mode {
        result = platform.fixed_point(output, result);
        drop report_test(state, result);
      }
    }
    drop platform.ready();
    input_size = host.read(0, source, 131072);
  }

  return 0;
}
