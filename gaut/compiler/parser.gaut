fn emit_callable(state, info, address, length, arguments) {
  let id = bitand(info, 255);
  let entry = 0;
  let branch = 0;

  if eq(info, 0) {
    entry = symbols.function_resolve(state, address, length, compiler.state_get(state, 176));
    branch = emitter.emit_word(state, 2483027968);
    if entry {
      drop emitter.patch_branch(state, branch, load64(add(entry, 24)), 1);
    }
    drop symbols.call_add(state, address, length, compiler.state_get(state, 176), arguments, branch, entry);
  } else {
    if eq(id, 16) {
      drop emitter.emit_binary(state, 2332098560);
    } else {
      if eq(id, 17) {
        drop emitter.emit_binary(state, 3405840384);
      } else {
        if eq(id, 18) {
          drop emitter.emit_binary(state, 2600565760);
        } else {
          if eq(id, 19) {
            drop emitter.emit_binary(state, 2315321344);
          } else {
            if eq(id, 20) {
              drop emitter.emit_binary(state, 2852192256);
            } else {
              if eq(id, 21) {
                drop emitter.emit_binary(state, 3389063168);
              } else {
                if eq(id, 22) {
                  drop emitter.emit_binary(state, 2596347904);
                } else {
                  if eq(id, 23) {
                    drop emitter.emit_binary(state, 2596348928);
                  } else {
                    if eq(id, 24) {
                      drop emitter.emit_compare(state, 2594117600);
                    } else {
                      if eq(id, 25) {
                        drop emitter.emit_compare(state, 2594121696);
                      } else {
                        if eq(id, 32) {
                          drop emitter.emit_load(state, 960495616);
                        } else {
                          if eq(id, 33) {
                            drop emitter.emit_load(state, 3107979264);
                          } else {
                            if eq(id, 34) {
                              drop emitter.emit_load(state, 4181721088);
                            } else {
                              if eq(id, 35) {
                                drop emitter.emit_store(state, 956301344);
                              } else {
                                if eq(id, 36) {
                                  drop emitter.emit_store(state, 3103784992);
                                } else {
                                  if eq(id, 37) {
                                    drop emitter.emit_store(state, 4177526816);
                                  } else {
                                    if eq(id, 64) {
                                      if eq(compiler.state_get(state, 160), 1) {
                                        drop emitter.emit_qemu_read(state);
                                      } else {
                                        if eq(compiler.state_get(state, 160), 2) {
                                          drop compiler.fail(state);
                                        } else {
                                          drop emitter.emit_host_call(state, 63, 1);
                                        }
                                      }
                                    } else {
                                      if eq(id, 65) {
                                        if compiler.state_get(state, 160) {
                                          drop emitter.emit_qemu_write(state);
                                        } else {
                                          drop emitter.emit_host_call(state, 64, 1);
                                        }
                                      } else {
                                        if eq(id, 66) {
                                          if eq(compiler.state_get(state, 160), 1) {
                                            drop emitter.emit_qemu_exit(state);
                                          } else {
                                            if eq(compiler.state_get(state, 160), 2) {
                                              drop emitter.emit_pop(state, 0);
                                              drop emitter.emit_qemu_halt(state);
                                            } else {
                                              drop emitter.emit_pop(state, 0);
                                              drop emitter.emit_move(state, 8, 93);
                                              drop emitter.emit_word(state, 3556769793);
                                            }
                                          }
                                        } else {
                                          if eq(id, 67) {
                                            drop emitter.emit_pop(state, 0);
                                            if eq(compiler.state_get(state, 160), 1) {
                                              drop emitter.emit_qemu_run(state);
                                            } else {
                                              if compiler.state_get(state, 160) {
                                                drop compiler.fail(state);
                                              }
                                            }
                                          } else {
                                            if eq(id, 68) {
                                              if eq(compiler.state_get(state, 160), 1) {
                                                drop emitter.emit_qemu_ready(state);
                                              } else {
                                                if eq(compiler.state_get(state, 160), 2) {
                                                  drop compiler.fail(state);
                                                }
                                              }
                                            } else {
                                              drop compiler.fail(state);
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return 0;
}

fn expression_push(state, address, length, info, arity, outputs, user_entry) {
  let depth = compiler.state_get(state, 120);
  let frame = add(add(state, 32768), mul(depth, 64));

  if eq(lt(depth, 64), 0) {
    drop compiler.fail(state);
  }

  store64(address, frame);
  store64(length, add(frame, 8));
  store64(info, add(frame, 16));
  store64(0, add(frame, 24));
  store64(arity, add(frame, 32));
  store64(outputs, add(frame, 40));
  store64(user_entry, add(frame, 48));
  drop compiler.state_set(state, 120, add(depth, 1));
  return frame;
}

fn expression_top(state) {
  let depth = compiler.state_get(state, 120);
  let frame = 0;

  if eq(depth, 0) {
    drop compiler.fail(state);
  }

  frame = add(add(state, 32768), mul(sub(depth, 1), 64));
  return frame;
}

fn expression_pop(state) {
  let frame = expression_top(state);
  drop compiler.state_set(state, 120, sub(compiler.state_get(state, 120), 1));
  return frame;
}

fn block_push(state, kind, first, second) {
  let depth = compiler.state_get(state, 112);
  let entry = 0;

  if eq(lt(depth, 64), 0) {
    drop compiler.fail(state);
  }

  entry = add(add(state, 24576), mul(depth, 24));
  store64(kind, entry);
  store64(first, add(entry, 8));
  store64(second, add(entry, 16));
  drop compiler.state_set(state, 112, add(depth, 1));
  return entry;
}

fn block_top(state) {
  let depth = compiler.state_get(state, 112);
  let entry = 0;

  if eq(depth, 0) {
    drop compiler.fail(state);
  }

  entry = add(add(state, 24576), mul(sub(depth, 1), 24));
  return entry;
}

fn block_set(state, kind, first, second) {
  let entry = block_top(state);
  store64(kind, entry);
  store64(first, add(entry, 8));
  store64(second, add(entry, 16));
  return 0;
}

fn block_pop(state) {
  let entry = block_top(state);
  drop compiler.state_set(state, 112, sub(compiler.state_get(state, 112), 1));
  return entry;
}

fn name_available(state, address, length, function_address, function_length) {
  let available = 1;

  if symbols.canonical_find(state, address, length) {
    available = 0;
  }
  if symbols.function_find(state, address, length) {
    available = 0;
  }
  if symbols.local_find(state, address, length) {
    available = 0;
  }
  if symbols.span_equal(address, length, function_address, function_length) {
    available = 0;
  }

  return available;
}

fn parse_expression(state) {
  let base_depth = compiler.state_get(state, 120);
  let need_value = 1;
  let done = 0;
  let result_outputs = 1;
  let kind = 0;
  let address = 0;
  let length = 0;
  let info = 0;
  let arity = 0;
  let outputs = 0;
  let user_entry = 0;
  let entry = 0;
  let frame = 0;
  let arguments = 0;

  while eq(done, 0) {
    if need_value {
      kind = compiler.state_get(state, 32);

      if eq(kind, 2) {
        drop emitter.emit_constant(state, compiler.state_get(state, 56));
        drop lexer.next_token(state);
        result_outputs = 1;
        need_value = 0;
      } else {
        if eq(kind, 1) {
          address = compiler.state_get(state, 40);
          length = compiler.state_get(state, 48);
          drop lexer.next_token(state);

          if eq(compiler.state_get(state, 32), 3) {
            info = symbols.canonical_find(state, address, length);
            user_entry = 0;

            if info {
              if eq(bitand(shr(info, 24), 255), 2) {
                arity = bitand(shr(info, 8), 255);
                outputs = bitand(shr(info, 16), 255);
              } else {
                drop compiler.fail(state);
              }
            } else {
              user_entry = symbols.function_resolve(state, address, length, compiler.state_get(state, 176));
              arity = 18446744073709551615;
              if user_entry {
                arity = load64(add(user_entry, 16));
              }
              outputs = 1;
            }

            frame = expression_push(state, address, length, info, arity, outputs, user_entry);
            drop lexer.next_token(state);

            if eq(compiler.state_get(state, 32), 4) {
              if eq(eq(arity, 18446744073709551615), 0) {
                if arity {
                  drop compiler.fail(state);
                }
              }
              drop emit_callable(state, info, address, length, 0);
              result_outputs = outputs;
              drop expression_pop(state);
              drop lexer.next_token(state);
              need_value = 0;
            } else {
              need_value = 1;
            }
          } else {
            entry = symbols.local_find(state, address, length);
            if eq(entry, 0) {
              drop compiler.fail(state);
            }

            if eq(load64(add(entry, 16)), 1) {
              drop emitter.emit_local_get(state, load64(add(entry, 24)));
            } else {
              if eq(load64(add(entry, 16)), 2) {
                drop emitter.emit_memory_base(state, load64(add(entry, 24)));
              } else {
                drop compiler.fail(state);
              }
            }

            result_outputs = 1;
            need_value = 0;
          }
        } else {
          drop compiler.fail(state);
        }
      }
    } else {
      if eq(compiler.state_get(state, 120), base_depth) {
        done = 1;
      } else {
        if eq(result_outputs, 1) {
          frame = expression_top(state);
          arguments = add(load64(add(frame, 24)), 1);
          store64(arguments, add(frame, 24));

          if eq(compiler.state_get(state, 32), 7) {
            drop lexer.next_token(state);
            need_value = 1;
          } else {
            if eq(compiler.state_get(state, 32), 4) {
              if eq(eq(load64(add(frame, 32)), 18446744073709551615), 0) {
                if eq(eq(arguments, load64(add(frame, 32))), 0) {
                  drop compiler.fail(state);
                }
              }

              info = load64(add(frame, 16));
              address = load64(frame);
              length = load64(add(frame, 8));
              result_outputs = load64(add(frame, 40));
              drop emit_callable(state, info, address, length, arguments);
              drop expression_pop(state);
              drop lexer.next_token(state);
              need_value = 0;
            } else {
              drop compiler.fail(state);
            }
          }
        } else {
          drop compiler.fail(state);
        }
      }
    }
  }

  return result_outputs;
}

fn parse_function(state) {
  let function_address = 0;
  let function_length = 0;
  let parameter_count = 0;
  let slot = 0;
  let parsing = 1;
  let info = 0;
  let id = 0;
  let expression_outputs = 0;
  let name_address = 0;
  let name_length = 0;
  let entry = 0;
  let block_kind = 0;
  let size = 0;
  let offset = 0;
  let is_main = 0;
  let code_start = 0;
  let block_entry = 0;
  let branch = 0;
  let function_index = 0;

  drop lexer.next_token(state);

  if eq(eq(compiler.state_get(state, 32), 1), 0) {
    drop compiler.fail(state);
  }

  function_address = compiler.state_get(state, 40);
  function_length = compiler.state_get(state, 48);

  if symbols.span_has_dot(function_address, function_length) {
    drop compiler.fail(state);
  }
  if symbols.canonical_find(state, function_address, function_length) {
    drop compiler.fail(state);
  }
  if symbols.function_find(state, function_address, function_length) {
    drop compiler.fail(state);
  }

  if eq(function_length, 4) {
    if eq(load8(function_address), 109) {
      if eq(load8(add(function_address, 1)), 97) {
        if eq(load8(add(function_address, 2)), 105) {
          if eq(load8(add(function_address, 3)), 110) {
            is_main = 1;
          }
        }
      }
    }
  }

  drop lexer.next_token(state);
  if eq(eq(compiler.state_get(state, 32), 3), 0) {
    drop compiler.fail(state);
  }
  drop lexer.next_token(state);

  drop compiler.state_set(state, 72, 0);

  if eq(eq(compiler.state_get(state, 32), 4), 0) {
    parsing = 1;
    while parsing {
      if eq(eq(compiler.state_get(state, 32), 1), 0) {
        drop compiler.fail(state);
      }

      name_address = compiler.state_get(state, 40);
      name_length = compiler.state_get(state, 48);
      if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
        drop compiler.fail(state);
      }
      if eq(lt(compiler.state_get(state, 80), 512), 0) {
        drop compiler.fail(state);
      }

      slot = compiler.state_get(state, 80);
      store64(slot, add(add(state, 36864), mul(parameter_count, 8)));
      drop symbols.local_add(state, name_address, name_length, 1, slot);
      drop compiler.state_set(state, 80, add(slot, 1));
      parameter_count = add(parameter_count, 1);

      drop lexer.next_token(state);
      if eq(compiler.state_get(state, 32), 7) {
        drop lexer.next_token(state);
      } else {
        parsing = 0;
      }
    }
  }

  if eq(eq(compiler.state_get(state, 32), 4), 0) {
    drop compiler.fail(state);
  }
  if bitand(is_main, eq(eq(parameter_count, 0), 0)) {
    drop compiler.fail(state);
  }
  if bitand(is_main, compiler.state_get(state, 104)) {
    drop compiler.fail(state);
  }

  code_start = compiler.state_get(state, 136);
  function_index = symbols.function_add(
    state,
    function_address,
    function_length,
    parameter_count,
    code_start,
    compiler.state_get(state, 176)
  );
  drop compiler.state_set(state, 184, function_index);
  if is_main {
    drop compiler.state_set(state, 144, code_start);
    drop compiler.state_set(state, 104, 1);
  }
  drop emitter.emit_word(state, 4177527486);
  drop emitter.emit_word(state, 2432705205);

  slot = parameter_count;
  while lt(0, slot) {
    slot = sub(slot, 1);
    drop emitter.emit_local_set(state, load64(add(add(state, 36864), mul(slot, 8))));
  }

  drop lexer.next_token(state);
  if eq(eq(compiler.state_get(state, 32), 5), 0) {
    drop compiler.fail(state);
  }
  drop lexer.next_token(state);
  drop compiler.state_set(state, 112, 0);
  parsing = 1;

  while parsing {
    if eq(compiler.state_get(state, 32), 0) {
      drop compiler.fail(state);
    }

    if eq(compiler.state_get(state, 32), 6) {
      if eq(compiler.state_get(state, 112), 0) {
        drop compiler.fail(state);
      }

      block_entry = block_top(state);
      block_kind = load64(block_entry);
      if eq(block_kind, 1) {
        drop lexer.next_token(state);
        info = 0;
        if eq(compiler.state_get(state, 32), 1) {
          info = symbols.canonical_find(state, compiler.state_get(state, 40), compiler.state_get(state, 48));
        }

        if eq(bitand(info, 255), 6) {
          branch = emitter.emit_word(state, 335544320);
          drop emitter.patch_zero_branch(state, load64(add(block_entry, 8)), compiler.state_get(state, 136));
          drop lexer.next_token(state);
          if eq(eq(compiler.state_get(state, 32), 5), 0) {
            drop compiler.fail(state);
          }
          drop block_set(state, 2, branch, 0);
          drop lexer.next_token(state);
        } else {
          drop emitter.patch_zero_branch(state, load64(add(block_entry, 8)), compiler.state_get(state, 136));
          drop block_pop(state);
        }
      } else {
        if eq(block_kind, 2) {
          drop emitter.patch_branch(state, load64(add(block_entry, 8)), compiler.state_get(state, 136), 0);
          drop block_pop(state);
          drop lexer.next_token(state);
        } else {
          if eq(block_kind, 3) {
            branch = emitter.emit_word(state, 335544320);
            drop emitter.patch_branch(state, branch, load64(add(block_entry, 8)), 0);
            drop emitter.patch_zero_branch(state, load64(add(block_entry, 16)), compiler.state_get(state, 136));
            drop block_pop(state);
            drop lexer.next_token(state);
          } else {
            drop compiler.fail(state);
          }
        }
      }
    } else {
      if eq(eq(compiler.state_get(state, 32), 1), 0) {
        drop compiler.fail(state);
      }

      info = symbols.canonical_find(state, compiler.state_get(state, 40), compiler.state_get(state, 48));
      id = bitand(info, 255);

      if eq(id, 8) {
        if compiler.state_get(state, 112) {
          drop compiler.fail(state);
        }

        drop lexer.next_token(state);
        expression_outputs = parse_expression(state);
        if eq(eq(expression_outputs, 1), 0) {
          drop compiler.fail(state);
        }
        if eq(eq(compiler.state_get(state, 32), 9), 0) {
          drop compiler.fail(state);
        }
        drop lexer.next_token(state);
        if eq(eq(compiler.state_get(state, 32), 6), 0) {
          drop compiler.fail(state);
        }

        drop emitter.emit_word(state, 3506447029);
        drop emitter.emit_word(state, 4181721790);
        drop emitter.emit_word(state, 3596551104);
        drop lexer.next_token(state);
        parsing = 0;
      } else {
        if eq(id, 2) {
          drop lexer.next_token(state);
          if eq(eq(compiler.state_get(state, 32), 1), 0) {
            drop compiler.fail(state);
          }

          name_address = compiler.state_get(state, 40);
          name_length = compiler.state_get(state, 48);
          if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
            drop compiler.fail(state);
          }

          drop lexer.next_token(state);
          if eq(eq(compiler.state_get(state, 32), 8), 0) {
            drop compiler.fail(state);
          }
          drop lexer.next_token(state);
          expression_outputs = parse_expression(state);
          if eq(eq(expression_outputs, 1), 0) {
            drop compiler.fail(state);
          }
          if eq(lt(compiler.state_get(state, 80), 512), 0) {
            drop compiler.fail(state);
          }

          slot = compiler.state_get(state, 80);
          drop symbols.local_add(state, name_address, name_length, 1, slot);
          drop emitter.emit_local_set(state, slot);
          drop compiler.state_set(state, 80, add(slot, 1));

          if eq(eq(compiler.state_get(state, 32), 9), 0) {
            drop compiler.fail(state);
          }
          drop lexer.next_token(state);
        } else {
          if eq(id, 3) {
            drop lexer.next_token(state);
            if eq(eq(compiler.state_get(state, 32), 1), 0) {
              drop compiler.fail(state);
            }

            name_address = compiler.state_get(state, 40);
            name_length = compiler.state_get(state, 48);
            if eq(name_available(state, name_address, name_length, function_address, function_length), 0) {
              drop compiler.fail(state);
            }

            drop lexer.next_token(state);
            if eq(eq(compiler.state_get(state, 32), 2), 0) {
              drop compiler.fail(state);
            }
            size = compiler.state_get(state, 56);
            if eq(size, 0) {
              drop compiler.fail(state);
            }

            offset = bitand(add(compiler.state_get(state, 88), 7), 18446744073709551608);
            if lt(sub(917504, offset), size) {
              drop compiler.fail(state);
            }

            drop symbols.local_add(state, name_address, name_length, 2, offset);
            drop compiler.state_set(state, 88, add(offset, size));
            drop lexer.next_token(state);
            if eq(eq(compiler.state_get(state, 32), 9), 0) {
              drop compiler.fail(state);
            }
            drop lexer.next_token(state);
          } else {
            if eq(id, 4) {
              drop lexer.next_token(state);
              expression_outputs = parse_expression(state);
              if eq(eq(expression_outputs, 1), 0) {
                drop compiler.fail(state);
              }
              drop emitter.emit_pop(state, 0);
              if eq(eq(compiler.state_get(state, 32), 9), 0) {
                drop compiler.fail(state);
              }
              drop lexer.next_token(state);
            } else {
              if eq(id, 5) {
                drop lexer.next_token(state);
                expression_outputs = parse_expression(state);
                if eq(eq(expression_outputs, 1), 0) {
                  drop compiler.fail(state);
                }
                drop emitter.emit_pop(state, 0);
                branch = emitter.emit_word(state, 3019898880);
                if eq(eq(compiler.state_get(state, 32), 5), 0) {
                  drop compiler.fail(state);
                }
                drop block_push(state, 1, branch, 0);
                drop lexer.next_token(state);
              } else {
                if eq(id, 7) {
                  branch = compiler.state_get(state, 136);
                  drop lexer.next_token(state);
                  expression_outputs = parse_expression(state);
                  if eq(eq(expression_outputs, 1), 0) {
                    drop compiler.fail(state);
                  }
                  drop emitter.emit_pop(state, 0);
                  entry = emitter.emit_word(state, 3019898880);
                  if eq(eq(compiler.state_get(state, 32), 5), 0) {
                    drop compiler.fail(state);
                  }
                  drop block_push(state, 3, branch, entry);
                  drop lexer.next_token(state);
                } else {
                  if eq(bitand(shr(info, 24), 255), 1) {
                    drop compiler.fail(state);
                  }

                  name_address = compiler.state_get(state, 40);
                  name_length = compiler.state_get(state, 48);
                  drop lexer.next_token(state);

                  if eq(compiler.state_get(state, 32), 8) {
                    entry = symbols.local_find(state, name_address, name_length);
                    if eq(entry, 0) {
                      drop compiler.fail(state);
                    }
                    if eq(eq(load64(add(entry, 16)), 1), 0) {
                      drop compiler.fail(state);
                    }

                    drop lexer.next_token(state);
                    expression_outputs = parse_expression(state);
                    if eq(eq(expression_outputs, 1), 0) {
                      drop compiler.fail(state);
                    }
                    drop emitter.emit_local_set(state, load64(add(entry, 24)));
                    if eq(eq(compiler.state_get(state, 32), 9), 0) {
                      drop compiler.fail(state);
                    }
                    drop lexer.next_token(state);
                  } else {
                    if eq(eq(compiler.state_get(state, 32), 3), 0) {
                      drop compiler.fail(state);
                    }

                    drop compiler.state_set(state, 0, name_address);
                    drop lexer.next_token(state);
                    expression_outputs = parse_expression(state);
                    if expression_outputs {
                      drop compiler.fail(state);
                    }
                    if eq(eq(compiler.state_get(state, 32), 9), 0) {
                      drop compiler.fail(state);
                    }
                    drop lexer.next_token(state);
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  return 0;
}
